-- ESP (NemesisHub.gg | V3) — fixed for Rivals / mobile / Drawing
----------------------------------------------------------------
do
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local LocalPlayer = Players.LocalPlayer

	local ESP = {
		Enabled = false,
		Box = true,
		Name = true,
		Health = true,
		Distance = true,
		Tracers = false,
		TeamCheck = false, -- false = show all (FFA / 1v1 / parties)
		MaxDistance = 2500,
		BoxColor = Color3.fromRGB(67, 107, 188),
		NameColor = Color3.fromRGB(255, 255, 255),
		TracerColor = Color3.fromRGB(67, 107, 188),
		BoxThickness = 1.5,
	}
	getgenv().NemesisESP = ESP

	local drawings = {}
	local highlights = {}
	local billboards = {}
	local hasDrawing = (type(Drawing) == "table" and type(Drawing.new) == "function")

	local function clearPlayer(plr)
		local pack = drawings[plr]
		if pack then
			for _, d in pairs(pack) do
				pcall(function()
					if d.Remove then d:Remove() elseif d.Destroy then d:Destroy() end
				end)
			end
			drawings[plr] = nil
		end
		local h = highlights[plr]
		if h then pcall(function() h:Destroy() end) highlights[plr] = nil end
		local b = billboards[plr]
		if b then pcall(function() b:Destroy() end) billboards[plr] = nil end
	end

	local function clearAll()
		for plr in pairs(drawings) do clearPlayer(plr) end
		for plr in pairs(highlights) do clearPlayer(plr) end
		for plr in pairs(billboards) do clearPlayer(plr) end
	end

	local function newLine(color, thick)
		if not hasDrawing then return nil end
		local ok, l = pcall(function()
			local x = Drawing.new("Line")
			x.Visible = false
			x.Color = color
			x.Thickness = thick or 1.5
			x.Transparency = 1
			return x
		end)
		return ok and l or nil
	end

	local function newText(color, size)
		if not hasDrawing then return nil end
		local ok, t = pcall(function()
			local x = Drawing.new("Text")
			x.Visible = false
			x.Color = color
			x.Size = size or 14
			x.Center = true
			x.Outline = true
			x.OutlineColor = Color3.new(0, 0, 0)
			x.Font = 2
			return x
		end)
		return ok and t or nil
	end

	local function ensureDrawing(plr)
		if drawings[plr] then return drawings[plr] end
		if not hasDrawing then return nil end
		local pack = {
			TL = newLine(ESP.BoxColor, ESP.BoxThickness),
			TR = newLine(ESP.BoxColor, ESP.BoxThickness),
			BL = newLine(ESP.BoxColor, ESP.BoxThickness),
			BR = newLine(ESP.BoxColor, ESP.BoxThickness),
			Top = newLine(ESP.BoxColor, ESP.BoxThickness),
			Bottom = newLine(ESP.BoxColor, ESP.BoxThickness),
			Left = newLine(ESP.BoxColor, ESP.BoxThickness),
			Right = newLine(ESP.BoxColor, ESP.BoxThickness),
			Name = newText(ESP.NameColor, 14),
			Health = newText(Color3.fromRGB(80, 255, 120), 13),
			Tracer = newLine(ESP.TracerColor, 1.2),
		}
		-- if any failed, don't use drawing pack
		for _, d in pairs(pack) do
			if d == nil then
				for _, x in pairs(pack) do
					if x then pcall(function() x:Remove() end) end
				end
				return nil
			end
		end
		drawings[plr] = pack
		return pack
	end

	local function ensureHighlight(plr)
		if highlights[plr] and highlights[plr].Parent then return highlights[plr] end
		local char = plr.Character
		if not char then return nil end
		local ok, h = pcall(function()
			local x = Instance.new("Highlight")
			x.Name = "NemesisESP"
			x.FillColor = ESP.BoxColor
			x.OutlineColor = ESP.BoxColor
			x.FillTransparency = 0.65
			x.OutlineTransparency = 0
			x.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			x.Adornee = char
			x.Parent = char
			return x
		end)
		if ok and h then highlights[plr] = h return h end
		return nil
	end

	local function ensureBillboard(plr)
		if billboards[plr] and billboards[plr].Parent then return billboards[plr] end
		local char = plr.Character
		local head = char and char:FindFirstChild("Head")
		if not head then return nil end
		local ok, bb = pcall(function()
			local b = Instance.new("BillboardGui")
			b.Name = "NemesisESPBB"
			b.Size = UDim2.fromOffset(120, 40)
			b.StudsOffset = Vector3.new(0, 2.2, 0)
			b.AlwaysOnTop = true
			b.Adornee = head
			b.Parent = head
			local lab = Instance.new("TextLabel")
			lab.BackgroundTransparency = 1
			lab.Size = UDim2.fromScale(1, 1)
			lab.Font = Enum.Font.Code
			lab.TextSize = 14
			lab.TextColor3 = ESP.NameColor
			lab.TextStrokeTransparency = 0.3
			lab.Text = plr.Name
			lab.Parent = b
			b:SetAttribute("Label", true)
			return b
		end)
		if ok and bb then billboards[plr] = bb return bb end
		return nil
	end

	local function isEnemy(plr)
		if not plr or plr == LocalPlayer then return false end
		if not ESP.TeamCheck then return true end
		local ok, enemy = pcall(function()
			-- Rivals: Team often nil in FFA; only skip real same-team
			if LocalPlayer.Team ~= nil and plr.Team ~= nil and LocalPlayer.Team == plr.Team then
				return false
			end
			local a = LocalPlayer:GetAttribute("TeamID") or LocalPlayer:GetAttribute("Team")
			local b = plr:GetAttribute("TeamID") or plr:GetAttribute("Team")
			if a ~= nil and b ~= nil and a == b then
				return false
			end
			return true
		end)
		return ok and enemy == true
	end

	local function worldToScreen(cam, v3)
		local v, on = cam:WorldToViewportPoint(v3)
		return Vector2.new(v.X, v.Y), on and v.Z > 0, v.Z
	end

	local conn

	local function stopESP()
		ESP.Enabled = false
		if conn then pcall(function() conn:Disconnect() end) conn = nil end
		clearAll()
	end

	local function startESP()
		if conn then return end
		ESP.Enabled = true
		-- re-detect Drawing each start
		hasDrawing = (type(Drawing) == "table" and type(Drawing.new) == "function")

		conn = RunService.RenderStepped:Connect(function()
			if not ESP.Enabled then return end
			local cam = workspace.CurrentCamera
			if not cam then return end
			local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
			local seen = {}

			for _, plr in ipairs(Players:GetPlayers()) do
				if plr ~= LocalPlayer and isEnemy(plr) then
					local char = plr.Character
					local hum = char and char:FindFirstChildOfClass("Humanoid")
					local root = char and char:FindFirstChild("HumanoidRootPart")
					local head = char and char:FindFirstChild("Head")
					if hum and root and head and hum.Health > 0 then
						local dist = myRoot and (root.Position - myRoot.Position).Magnitude or 0
						if not (ESP.MaxDistance > 0 and dist > ESP.MaxDistance) then
							seen[plr] = true

							-- Always-on-top highlight (works without Drawing)
							if ESP.Box then
								local h = ensureHighlight(plr)
								if h then
									h.FillColor = ESP.BoxColor
									h.OutlineColor = ESP.BoxColor
									h.Enabled = true
									if h.Adornee ~= char then h.Adornee = char end
								end
							else
								local h = highlights[plr]
								if h then h.Enabled = false end
							end

							-- Name / health / distance billboard
							if ESP.Name or ESP.Health or ESP.Distance then
								local bb = ensureBillboard(plr)
								if bb then
									local lab = bb:FindFirstChildOfClass("TextLabel")
									if lab then
										local parts = {}
										if ESP.Name then table.insert(parts, plr.DisplayName or plr.Name) end
										if ESP.Health then table.insert(parts, string.format("[%d]", math.floor(hum.Health))) end
										if ESP.Distance and myRoot then table.insert(parts, string.format("%dm", math.floor(dist))) end
										lab.Text = table.concat(parts, " ")
										lab.TextColor3 = ESP.NameColor
									end
									bb.Enabled = true
								end
							else
								local bb = billboards[plr]
								if bb then bb.Enabled = false end
							end

							-- Drawing corner box if available
							local pack = ensureDrawing(plr)
							if pack then
								local topPos = head.Position + Vector3.new(0, 0.5, 0)
								local bottomPos = root.Position - Vector3.new(0, 3, 0)
								local top, topOn = worldToScreen(cam, topPos)
								local bottom, botOn = worldToScreen(cam, bottomPos)
								local mid, midOn, depth = worldToScreen(cam, root.Position)
								local visible = (topOn or botOn or midOn) and depth > 0
								local h = math.max(math.abs(top.Y - bottom.Y), 8)
								local w = h * 0.45
								local x1, x2 = mid.X - w / 2, mid.X + w / 2
								local y1, y2 = top.Y, bottom.Y
								local corner = math.clamp(h * 0.25, 6, 18)
								local boxOn = ESP.Box and visible
								for _, key in ipairs({"TL","TR","BL","BR","Top","Bottom","Left","Right"}) do
									pack[key].Color = ESP.BoxColor
									pack[key].Thickness = ESP.BoxThickness
									pack[key].Transparency = 1
								end
								-- Eazvy classic corner box (8 L-shaped segments)
								-- top-left
								pack.TL.From = Vector2.new(x1, y1)
								pack.TL.To   = Vector2.new(x1 + corner, y1)
								pack.TL.Visible = boxOn
								pack.Left.From = Vector2.new(x1, y1)
								pack.Left.To   = Vector2.new(x1, y1 + corner)
								pack.Left.Visible = boxOn
								-- top-right
								pack.TR.From = Vector2.new(x2, y1)
								pack.TR.To   = Vector2.new(x2 - corner, y1)
								pack.TR.Visible = boxOn
								pack.Right.From = Vector2.new(x2, y1)
								pack.Right.To   = Vector2.new(x2, y1 + corner)
								pack.Right.Visible = boxOn
								-- bottom-left
								pack.BL.From = Vector2.new(x1, y2)
								pack.BL.To   = Vector2.new(x1 + corner, y2)
								pack.BL.Visible = boxOn
								pack.Top.From = Vector2.new(x1, y2)
								pack.Top.To   = Vector2.new(x1, y2 - corner)
								pack.Top.Visible = boxOn
								-- bottom-right
								pack.BR.From = Vector2.new(x2, y2)
								pack.BR.To   = Vector2.new(x2 - corner, y2)
								pack.BR.Visible = boxOn
								pack.Bottom.From = Vector2.new(x2, y2)
								pack.Bottom.To   = Vector2.new(x2, y2 - corner)
								pack.Bottom.Visible = boxOn

								if pack.Name then
									pack.Name.Text = (ESP.Name and (plr.DisplayName or plr.Name) or "")
									pack.Name.Position = Vector2.new(mid.X, y1 - 16)
									pack.Name.Color = ESP.NameColor
									pack.Name.Visible = ESP.Name and visible
								end
								if pack.Health then
									pack.Health.Text = ESP.Health and string.format("%d HP", math.floor(hum.Health)) or ""
									pack.Health.Position = Vector2.new(mid.X, y2 + 4)
									pack.Health.Visible = ESP.Health and visible
								end
								if pack.Tracer then
									local from = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
									pack.Tracer.From = from
									pack.Tracer.To = mid
									pack.Tracer.Color = ESP.TracerColor
									pack.Tracer.Visible = ESP.Tracers and visible
								end
							end
						else
							clearPlayer(plr)
						end
					else
						clearPlayer(plr)
					end
				else
					if plr ~= LocalPlayer then clearPlayer(plr) end
				end
			end

			for plr in pairs(drawings) do
				if not seen[plr] then clearPlayer(plr) end
			end
			for plr in pairs(highlights) do
				if not seen[plr] then clearPlayer(plr) end
			end
			for plr in pairs(billboards) do
				if not seen[plr] then clearPlayer(plr) end
			end
		end)
	end

	getgenv().NemesisStartESP = startESP
	getgenv().NemesisStopESP = stopESP

	Players.PlayerRemoving:Connect(function(plr)
		clearPlayer(plr)
	end)

	local ESPBox = Tabs.ESP:AddLeftGroupbox("ESP")
	ESPBox:AddToggle("ESPEnabled", {
		Text = "Enabled",
		Default = false,
		Callback = function(v)
			if v then startESP() else stopESP() end
		end,
	})
	ESPBox:AddToggle("ESPBox", {
		Text = "Box / Highlight",
		Default = true,
		Callback = function(v) ESP.Box = v end,
	}):AddColorPicker("ESPBoxColor", {
		Default = ESP.BoxColor,
		Callback = function(c) ESP.BoxColor = c end,
	})
	ESPBox:AddToggle("ESPName", {
		Text = "Name",
		Default = true,
		Callback = function(v) ESP.Name = v end,
	}):AddColorPicker("ESPNameColor", {
		Default = ESP.NameColor,
		Callback = function(c) ESP.NameColor = c end,
	})
	ESPBox:AddToggle("ESPHealth", {
		Text = "Health",
		Default = true,
		Callback = function(v) ESP.Health = v end,
	})
	ESPBox:AddToggle("ESPDistance", {
		Text = "Distance",
		Default = true,
		Callback = function(v) ESP.Distance = v end,
	})
	ESPBox:AddToggle("ESPTracers", {
		Text = "Tracers",
		Default = false,
		Callback = function(v) ESP.Tracers = v end,
	}):AddColorPicker("ESPTracerColor", {
		Default = ESP.TracerColor,
		Callback = function(c) ESP.TracerColor = c end,
	})
	ESPBox:AddToggle("ESPTeamCheck", {
		Text = "Team Check",
		Default = false,
		Callback = function(v) ESP.TeamCheck = v end,
	})
	ESPBox:AddSlider("ESPMaxDist", {
		Text = "Max Distance",
		Min = 100,
		Max = 5000,
		Default = 2500,
		Rounding = 0,
		Callback = function(v) ESP.MaxDistance = v end,
	})
	ESPBox:AddSlider("ESPBoxThick", {
		Text = "Box Thickness",
		Min = 1,
		Max = 4,
		Default = 1.5,
		Rounding = 1,
		Callback = function(v) ESP.BoxThickness = v end,
	})
end


