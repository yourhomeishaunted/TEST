----------------------------------------------------------------
-- Permanent skins + configs (Delta-safe writefile)
-- skins: NemesisHub/skins.json  (and fallback root path)
----------------------------------------------------------------
do
	local HttpService = game:GetService("HttpService")
	local PATHS = {
		"NemesisHub/skins.json",
		"nemesis_skins.json",
		"NemesisHub_skins.json",
	}
	local CFG_DEFAULTS = {
		FireRate = 0.0002,
		HitDelay = 0.35,
		WeaponSlot = "Melee",
		PreferredWeapon = "Melee",
		VoidSpam = false,
		VoidStrength = 18,
	}

	local function ensureFolder()
		pcall(function()
			if type(makefolder) == "function" then
				pcall(makefolder, "NemesisHub")
				pcall(makefolder, "NemesisHub/settings")
				pcall(makefolder, "NemesisHub/rivals")
				pcall(makefolder, "NemesisHub/rivals/settings")
			end
		end)
	end
	ensureFolder()

	local function tryWrite(path, content)
		if type(writefile) ~= "function" then return false end
		local ok = pcall(writefile, path, content)
		return ok
	end

	local function tryRead(path)
		if type(readfile) ~= "function" then return nil end
		if type(isfile) == "function" then
			local ok, exists = pcall(isfile, path)
			if ok and not exists then return nil end
		end
		local ok, data = pcall(readfile, path)
		if ok and type(data) == "string" and #data > 2 then return data end
		return nil
	end

	getgenv().NemesisNormalizeConfig = function()
		local c = getgenv().Config
		if type(c) ~= "table" then
			getgenv().Config = {}
			c = getgenv().Config
		end
		for k, v in pairs(CFG_DEFAULTS) do
			if c[k] == nil or c[k] == "" then c[k] = v end
		end
	end

	getgenv().NemesisSaveSkins = function()
		ensureFolder()
		pcall(function()
			if getgenv().NemesisSerializeEquip then
				getgenv().NemesisSerializeEquip()
			end
		end)

		local equipMap = {}
		local fcMap = {}
		pcall(function()
			if type(getgenv().NemesisEquipNames) == "table" then
				for w, row in pairs(getgenv().NemesisEquipNames) do
					if type(w) == "string" and type(row) == "table" then
						local r = {}
						for ct, nm in pairs(row) do
							if type(ct) == "string" and type(nm) == "string" and nm ~= "" then
								r[ct] = nm
							end
						end
						if next(r) then equipMap[w] = r end
					end
				end
			end
		end)
		pcall(function()
			if type(getgenv().NemesisFinisherNames) == "table" then
				for w, n in pairs(getgenv().NemesisFinisherNames) do
					if type(w) == "string" and type(n) == "string" then fcMap[w] = n end
				end
			end
		end)

		-- if live equip table has data but names empty, parse live
		pcall(function()
			local eq = getgenv().NemesisEquipTable
			if type(eq) == "table" then
				for weapon, slots in pairs(eq) do
					if type(weapon) == "string" and type(slots) == "table" then
						equipMap[weapon] = equipMap[weapon] or {}
						for ctype, cos in pairs(slots) do
							local name = nil
							if type(cos) == "string" then name = cos
							elseif type(cos) == "table" then name = cos.Name or cos.DisplayName end
							if type(name) == "string" and name ~= "" then
								equipMap[weapon][ctype] = name
							end
						end
						if not next(equipMap[weapon]) then equipMap[weapon] = nil end
					end
				end
			end
		end)

		local data = {
			equip = equipMap,
			fcache = fcMap,
			_savedAt = os.time(),
			_ver = 2,
		}
		-- keep previous weapons if new map empty (don't wipe)
		if not next(equipMap) then
			pcall(function()
				for _, p in ipairs(PATHS) do
					local raw = tryRead(p)
					if raw then
						local ok, prev = pcall(function() return HttpService:JSONDecode(raw) end)
						if ok and type(prev) == "table" and type(prev.equip) == "table" and next(prev.equip) then
							data.equip = prev.equip
							data.fcache = type(prev.fcache) == "table" and prev.fcache or fcMap
							break
						end
					end
				end
			end)
		end

		getgenv().NemesisSkinConfig = data
		getgenv().NemesisEquipNames = data.equip
		getgenv().NemesisFinisherNames = data.fcache
		getgenv().LionSkinState = data
		getgenv().NemesisCosmeticMirror = data

		local payload = HttpService:JSONEncode(data)
		local wrote = false
		for _, p in ipairs(PATHS) do
			if tryWrite(p, payload) then
				wrote = true
			end
		end
		-- also keep in getgenv forever for same-session re-execute
		getgenv().__NemesisSkinsForever = data
		return wrote
	end

	getgenv().NemesisLoadSkins = function()
		ensureFolder()
		local data = nil
		-- 1) getgenv cache (same session)
		if type(getgenv().__NemesisSkinsForever) == "table" and type(getgenv().__NemesisSkinsForever.equip) == "table" then
			data = getgenv().__NemesisSkinsForever
		end
		-- 2) disk
		if not data then
			for _, p in ipairs(PATHS) do
				local raw = tryRead(p)
				if raw then
					local ok, decoded = pcall(function() return HttpService:JSONDecode(raw) end)
					if ok and type(decoded) == "table" then
						data = decoded
						break
					end
				end
			end
		end
		if type(data) ~= "table" then return false end
		getgenv().NemesisSkinConfig = data
		getgenv().NemesisEquipNames = type(data.equip) == "table" and data.equip or {}
		getgenv().NemesisFinisherNames = type(data.fcache) == "table" and data.fcache or {}
		getgenv().__NemesisSkinsForever = data
		getgenv().LionSkinState = data
		getgenv().NemesisCosmeticMirror = data
		return true
	end

	getgenv().NemesisApplySavedSkins = function()
		local data = getgenv().NemesisSkinConfig or getgenv().__NemesisSkinsForever
		if type(data) ~= "table" or type(data.equip) ~= "table" then return false end
		local apply = getgenv().NemesisApplyCosmetic
		if type(apply) ~= "function" then return false end
		local applied = 0
		for weapon, row in pairs(data.equip) do
			if type(weapon) == "string" and type(row) == "table" then
				for ctype, cname in pairs(row) do
					if type(cname) == "string" and cname ~= "" then
						local ok = pcall(apply, weapon, cname, ctype, true)
						if ok then applied = applied + 1 end
					end
				end
			end
		end
		pcall(function()
			if getgenv().NemesisRebuildInv then getgenv().NemesisRebuildInv() end
		end)
		pcall(function()
			if getgenv().NemesisSafeRep then
				getgenv().NemesisSafeRep("CosmeticInventory")
				getgenv().NemesisSafeRep("WeaponInventory")
			end
		end)
		return applied > 0
	end

	pcall(getgenv().NemesisLoadSkins)
	pcall(getgenv().NemesisNormalizeConfig)

	-- re-apply several times (Delta + Rivals load order is slow)
	task.spawn(function()
		for _, waitSec in ipairs({ 1, 2, 4, 6, 10 }) do
			task.wait(waitSec)
			pcall(getgenv().NemesisLoadSkins)
			pcall(getgenv().NemesisApplySavedSkins)
		end
	end)

	task.spawn(function()
		while true do
			task.wait(3)
			pcall(function()
				if getgenv().NemesisSerializeEquip then getgenv().NemesisSerializeEquip() end
				if getgenv().NemesisSaveSkins then getgenv().NemesisSaveSkins() end
			end)
		end
	end)

	pcall(function()
		game:GetService("Players").LocalPlayer.OnTeleport:Connect(function()
			pcall(getgenv().NemesisSaveSkins)
		end)
	end)
	pcall(function()
		game:BindToClose(function()
			pcall(getgenv().NemesisSaveSkins)
		end)
	end)

	-- hook SaveManager
	task.spawn(function()
		for _ = 1, 40 do
			task.wait(0.2)
			if SaveManager and type(SaveManager.Save) == "function" then break end
		end
		pcall(function()
			if not SaveManager or SaveManager.__NemesisHooked then return end
			SaveManager.__NemesisHooked = true
			pcall(function()
				SaveManager:SetIgnoreIndexes({ "MenuKeybind", "XCSConfig" })
			end)
			local oldSave = SaveManager.Save
			SaveManager.Save = function(self, name, ...)
				pcall(getgenv().NemesisNormalizeConfig)
				pcall(getgenv().NemesisSaveSkins)
				pcall(function() self:BuildFolderTree() end)
				local ok, err = oldSave(self, name, ...)
				pcall(getgenv().NemesisSaveSkins)
				return ok, err
			end
			local oldLoad = SaveManager.Load
			SaveManager.Load = function(self, name, ...)
				if Library then Library.Notify = function(...) end end
				local ok, err = oldLoad(self, name, ...)
				pcall(getgenv().NemesisNormalizeConfig)
				pcall(getgenv().NemesisLoadSkins)
				task.defer(function()
					pcall(getgenv().NemesisApplySavedSkins)
				end)
				return ok, err
			end
		end)
	end)
end

pcall(function() if Library then Library.Notify = function(...) end end end)


