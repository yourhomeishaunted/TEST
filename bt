-- Reliable menu keybind (works even when gameProcessed is true)
local UIS_MENU = game:GetService("UserInputService")
local function menuKeyMatches(input)
	if input.UserInputType ~= Enum.UserInputType.Keyboard then
		return false
	end
	local name = input.KeyCode and input.KeyCode.Name
	if not name then return false end
	-- default / fallback
	if name == "RightShift" or name == "RightControl" then
		return true
	end
	local kb = Options and Options.MenuKeybind
	if not kb then return false end
	local v = kb.Value
	if type(v) == "string" then
		return v == name or v == "RightShift" and name == "RightShift"
	end
	if typeof(v) == "EnumItem" then
		return v.Name == name
	end
	return false
end

UIS_MENU.InputBegan:Connect(function(input, gp)
	if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
	if not menuKeyMatches(input) then return end
	-- ignore typing in text boxes only
	local focused = UIS_MENU:GetFocusedTextBox()
	if focused then return end
	pcall(function()
		if Library.Toggle then
			Library:Toggle()
		end
	end)
end)

Menu:AddButton("Toggle Menu", function()
	pcall(function() Library:Toggle() end)
