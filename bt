		EZ:AddToRegistry(RgbBoxBase.Frame, { BackgroundColor3 = 'MainColor'; BorderColor3 = 'OutlineColor'; });
		EZ:AddToRegistry(RgbBox, { TextColor3 = 'FontColor', });
		EZ:AddToRegistry(HueBox, { TextColor3 = 'FontColor', });

		local SequenceTable = {};

