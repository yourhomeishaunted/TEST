function EZ:SafeCallback(f, ...)
	if (not f) then
		return;
	end;

	local success, event = pcall(f, ...);

	if (not success) and EZ.NotifyOnError then
		local _, i = event:find(":%d+: ");

		if not i then
			return EZ:Notify(event);
		end;

		return EZ:Notify(event:sub(i + 1), 3);
	end;
end;

