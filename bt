-- Swap YOUR weapons when empty (Rivals ammo) — Primary -> Secondary -> Melee
local function isItemEmpty(item)
	if item == nil then return true end
	local empty = false
	pcall(function()
		local ammo = nil
		if type(item.Get) == "function" then
			ammo = item:Get("Ammo")
			if ammo == nil then ammo = item:Get("AmmoCount") end
		end
		if ammo == nil and type(item.Data) == "table" then
			ammo = item.Data.Ammo or item.Data.AmmoCount
		end
		if ammo == nil and item.Info then
			ammo = item.Info.Ammo
		end
		if ammo ~= nil and tonumber(ammo) ~= nil and tonumber(ammo) <= 0 then
			empty = true
		end
		-- reloading counts as not ready; still switch if ammo is 0
		if item.Info and item.Info.Ammo ~= nil and tonumber(item.Info.Ammo) <= 0 then
			empty = true
		end
	end)
	return empty
end

local function autoSwitchIfEmpty(FC)
	local cfg = getgenv().Config
	if not cfg.AutoSwitch or not FC or not FC.LocalFighter then return end
	if tick() - lastSwitchAt < 0.35 then return end
	local lf = FC.LocalFighter
	local item = lf.EquippedItem
	if not isItemEmpty(item) then return end

	lastSwitchAt = tick()
	local order = { "Primary", "Secondary", "Melee" }
	local cur = tostring(cfg.WeaponSlot or cfg.PreferredWeapon or "Primary")
	if cur == "Knife" then cur = "Melee" end
	local startIdx = 1
	for i, s in ipairs(order) do
		if s == cur then startIdx = i break end
	end
	-- next slots after current (and wrap)
	for step = 1, #order do
		local idx = ((startIdx - 1 + step) % #order) + 1
		local slot = order[idx]
		pcall(function() lf:EquipItem(getSlotIndex(slot)) end)
		cfg.WeaponSlot = slot
		cfg.PreferredWeapon = slot
		-- confirm not empty after switch; if still empty try next
		local newItem = lf.EquippedItem
		if newItem and not isItemEmpty(newItem) then
			return
		end
	end
end

local function startRagebot()
	stopRagebot()
	local myGen = gen
	getgenv().Config.Enabled = true
	-- Hit Delay (0 = instant; default from slider)
	local hd = math.max(tonumber(getgenv().Config.HitDelay) or 0, 0)
	getgenv().Config.ReadyAt = (hd > 0) and (tick() + hd) or 0
	getgenv().__NemesisSpawnProtectUntil = 0
	getgenv().__NemesisLastFire = 0

	local ok, err = pcall(function()
		local repS = cloneref(game:GetService("ReplicatedStorage"))
		local plrs = cloneref(game:GetService("Players"))
		local runS = cloneref(game:GetService("RunService"))
		local ws = cloneref(game:GetService("Workspace"))
		local lplr = plrs.LocalPlayer

		local util = require(repS.Modules.Utility)
		local enum = require(repS.Modules.EnumLibrary)
		local FighterController = require(lplr.PlayerScripts.Controllers.FighterController)
		local SpectateController = require(lplr.PlayerScripts.Controllers:WaitForChild("SpectateController"))

		local slots = { Primary = 1, Secondary = 2, Melee = 3 }
		local function getSlotNumber()
			local s = tostring(getgenv().Config.PreferredWeapon or getgenv().Config.WeaponSlot or "Melee")
			return slots[s] or 3
		end

		-- equip chosen slot (Primary / Secondary / Melee)
		task.spawn(function()
			local t0 = tick()
			while tick() - t0 < 15 and gen == myGen do
				local lf = FighterController.LocalFighter
				if lf then
					pcall(function() lf:EquipItem(getSlotNumber()) end)
					break
				end
				task.wait(0.1)
			end
		end)
		task.spawn(function()
			while gen == myGen do
				task.wait(0.75)
				if not getgenv().Config.Enabled then continue end
				local lf = FighterController.LocalFighter
				if lf then
					pcall(function() lf:EquipItem(getSlotNumber()) end)
				end
			end
		end)

		local lastFire = 0
		local deflecting = {}
		plrs.PlayerRemoving:Connect(function(player)
			deflecting[player] = nil
		end)

		local function updateDeflection()
			if not FighterController or not FighterController.Objects then return end
			for _, fighterObj in FighterController.Objects do
				local player = fighterObj.Player
				if not player then continue end
				if not fighterObj.Entity or not fighterObj.Entity:IsAlive() or fighterObj:Get("IsSpectating") then
					deflecting[player] = false
					continue
				end
				local equipped = fighterObj.EquippedItem
				local isKatana = equipped and equipped.ViewModel and equipped.ViewModel.Name == "Katana"
				local isDeflecting = false
				if isKatana then
					isDeflecting = (equipped._attack_cooldown and equipped._attack_cooldown > tick()) or false
				end
				deflecting[player] = isDeflecting
			end
		end

		local function isEnemy(player)
			if not player or player == lplr then return false end
			local okD, result = pcall(function()
				local duel = SpectateController and SpectateController.CurrentDuelSubject
				local localDueler = duel and duel:GetDueler(lplr)
				local localTeam = localDueler and localDueler:Get("TeamID") or nil
				if localTeam and duel and duel.Duelers then
					for _, dueler in duel.Duelers do
						if dueler.Player == player then
							local team = dueler:Get("TeamID")
							return team ~= localTeam
						end
					end
				end
				local pTeam = player:GetAttribute("TeamID")
				local lTeam = lplr:GetAttribute("TeamID")
				if pTeam ~= nil and lTeam ~= nil then
					return pTeam ~= lTeam
				end
				if player.Team ~= nil and lplr.Team ~= nil then
					return player.Team ~= lplr.Team
				end
				return true -- FFA
			end)
			if okD and result ~= nil then return result end
			return true
		end

		local function getClosestTarget()
			local char = lplr.Character
			if not char then return nil, nil, nil end
			local myRoot = char:FindFirstChild("HumanoidRootPart")
			if not myRoot then return nil, nil, nil end
			local bestP, bestR, bestH, bestD = nil, nil, nil, 1e9
			for _, player in ipairs(plrs:GetPlayers()) do
				if isEnemy(player) and player.Character then
					local ch = player.Character
					local pRoot = ch:FindFirstChild("HumanoidRootPart")
					-- HEAD hitbox ONLY — never body / never Head mesh
					local pHead = ch:FindFirstChild("HitboxHead")
						or ch:FindFirstChild("HitboxHeadSmall")
						or ch:FindFirstChild("PhysicalHitboxHead")
					if not pHead then
						for _, d in ipairs(ch:GetDescendants()) do
							if d:IsA("BasePart") then
								local n = d.Name
								if n == "HitboxHead" or n == "HitboxHeadSmall" or n == "PhysicalHitboxHead" then
									pHead = d
									break
								end
							end
						end
					end
					local pHum = ch:FindFirstChildWhichIsA("Humanoid")
					if pRoot and pHead and pHum and pHum.Health > 0 then
						local d = (myRoot.Position - pRoot.Position).Magnitude
						if d < bestD then
							bestD, bestP, bestR, bestH = d, player, pRoot, pHead
						end
					end
				end
			end
			return bestP, bestR, bestH
		end

		local function hasKnifeViewModel(targetPlayer)
			if not targetPlayer then return false end
			local viewModels = ws:FindFirstChild("ViewModels")
			if not viewModels then return false end
			local targetName = targetPlayer.Name
			for _, model in viewModels:GetChildren() do
				if model:IsA("Model")
					and string.find(model.Name, targetName, 1, true)
					and string.find(model.Name, "Knife", 1, true) then
					return true
				end
			end
			return false
		end

		pcall(function() setRageHud("ragebot: idle") end)

		rbConn = runS.Heartbeat:Connect(function()
			if gen ~= myGen then return end
			if not getgenv().Config.Enabled then return end

			pcall(updateDeflection)
			local targetPlayer, targetRoot, targetHead = getClosestTarget()
			local desyncCF = nil

			-- TOP of head (instant lock every frame)
			if targetRoot and targetHead then
				local headPos = targetHead.Position
				-- Backstab Desync Position (Behind and slightly up)
				local slot = tostring(getgenv().Config.PreferredWeapon or getgenv().Config.WeaponSlot or "")
				local isMelee = (slot == "Melee" or slot == "Knife") or hasKnifeViewModel(targetPlayer)
				
				if isMelee then
					-- Exactly on the head, facing backwards towards the body (Head + Backstab)
					desyncCF = CFrame.lookAt(targetHead.Position, targetRoot.Position)
				else
					-- Normal top-of-head desync for guns
					local topPos = Vector3.new(headPos.X, headPos.Y + 1.2, headPos.Z)
					local _, y, _ = targetRoot.CFrame:ToOrientation()
					desyncCF = CFrame.new(topPos) * CFrame.Angles(0, y, 0)
				end

			end

			-- Void spam phase: short fire window, longer void hide
			local cfg = getgenv().Config
			local now = tick()
			local function isRoundStarted()
				if targetPlayer and targetRoot then return true end
				for _, p in ipairs(plrs:GetPlayers()) do
					if p ~= lplr and p.Character then
						local hum = p.Character:FindFirstChildWhichIsA("Humanoid")
						if hum and hum.Health > 0 then return true end
					end
				end
				return false
			end

			if cfg.VoidSpam then
				-- Attack window short, hide/void window longer so void is visible
				local atkT = math.max(tonumber(cfg.AttackTime) or 0.08, 0.05)
				local hideT = math.max(tonumber(cfg.HideTime) or 0.35, 0.2)
				if voidPhaseEnd == 0 then
					-- start in VOID (hide) so effect is immediate
					voidAttacking = false
					voidPhaseEnd = now + hideT
				elseif now >= voidPhaseEnd then
					voidAttacking = not voidAttacking
					voidPhaseEnd = now + (voidAttacking and atkT or hideT)
				end
				-- prevent falling death while voiding
				pcall(function()
					if not getgenv().__NemesisOldDestroyH then
						getgenv().__NemesisOldDestroyH = workspace.FallenPartsDestroyHeight
					end
					workspace.FallenPartsDestroyHeight = -50000
				end)
			else
				voidAttacking = true
				voidPhaseEnd = 0
				pcall(function()
					if getgenv().__NemesisOldDestroyH then
						workspace.FallenPartsDestroyHeight = getgenv().__NemesisOldDestroyH
						getgenv().__NemesisOldDestroyH = nil
					end
				end)
			end
			local inFireWindow = (not cfg.VoidSpam) or voidAttacking

			-- Build void CF even without prior desync (still need a root)
			if lplr.Character then
				local myRoot = lplr.Character:FindFirstChild("HumanoidRootPart")
				if myRoot then
					local oldCF = myRoot.CFrame
					local oldVel = myRoot.AssemblyLinearVelocity
					local oldRot = myRoot.AssemblyAngularVelocity
					local applyCF = desyncCF or oldCF

					-- UNNAMED STYLE POV VOID (Powerful)
					if cfg.VoidSpam and not inFireWindow and isRoundStarted() then
						local strength = math.clamp(tonumber(cfg.VoidStrength) or 32, 8, 55)
						
						-- 1. Calculate deep void position (Aggressive)
						local voidY = -80 - (strength * 3)
						local voidPos = Vector3.new(oldCF.Position.X, voidY, oldCF.Position.Z)
						
						-- 2. Save the real camera POV
						local realCamCFrame = workspace.CurrentCamera.CFrame
						
						-- 3. Snap the character into the void (This fools the enemy server)
						local lookTarget = (targetHead and targetHead.Position) or (voidPos + Vector3.new(0, 10, 0))
						applyCF = CFrame.lookAt(voidPos, lookTarget)
						
						-- 4. Shoot from the void
						task.defer(function()
							pcall(function()
								if not targetHead then return end
								local lf = FighterController and FighterController.LocalFighter
								local item = lf and lf.EquippedItem
								local oid
								if item then
									pcall(function() oid = item:Get("ObjectID") end)
									if not oid then pcall(function() oid = item.Data and (item.Data.ObjectID or item.Data.ObjectId) end) end
								end
								if not oid then return end
								local aimCF = CFrame.lookAt(voidPos, targetHead.Position)
								local cameradata = {
									[utf8.char(1)] = {
										[utf8.char(0)] = util:EncodeCFrame(aimCF),
										[utf8.char(1)] = util:EncodeCFrame(targetHead.CFrame),
										[utf8.char(2)] = targetHead,
										[utf8.char(3)] = util:EncodeCFrame(CFrame.new(0,0,0)),
									}
								}
								local remote = repS.Remotes.Replication.Fighter.UseItem
								local shot = enum:ToEnum("StartShooting")
								remote:FireServer(oid, shot, cameradata, nil)
								task.wait()
								pcall(function()
									workspace.CurrentCamera.CFrame = realCamCFrame
								end)
							end)
						end)
						
						pcall(function()
							local n = targetPlayer and targetPlayer.Name or "?"
							setRageHud("ragebot: voiding @" .. n)
						end)
					else
						if desyncCF then
							applyCF = desyncCF
						end
						-- cleanup any leftover bait clone from old void mode
						pcall(function()
							if getgenv().__BaitVoid then
								getgenv().__BaitVoid:Destroy()
								getgenv().__BaitVoid = nil
							end
						end)
					end

					if cfg.VoidSpam or desyncCF then
						myRoot.CFrame = applyCF
						pcall(function()
							myRoot.AssemblyLinearVelocity = Vector3.zero
							myRoot.AssemblyAngularVelocity = Vector3.zero
						end)
						runS:BindToRenderStep("__restore", 101, function()
							if myRoot then
								myRoot.CFrame = oldCF
								pcall(function()
									myRoot.AssemblyLinearVelocity = oldVel
									myRoot.AssemblyAngularVelocity = oldRot
								end)
							end
							pcall(function() runS:UnbindFromRenderStep("__restore") end)
						end)
					end
				end
			end

			if not targetPlayer or not targetHead or not targetRoot then
				pcall(function() setRageHud("ragebot: idle") end)
				return
			end

			-- Hit Delay (only if set)
			local ra = getgenv().Config.ReadyAt or 0
			if ra > 0 and tick() < ra then
				pcall(function()
					setRageHud(string.format("ragebot: delay %.1fs", ra - tick()))
				end)
				return
			end

			-- Katana deflect wait
			if deflecting[targetPlayer] then
				pcall(function() setRageHud("ragebot: waiting katana") end)
				return
			end

			-- Force field / invincible check (Rivals fighter Data.IsInvincible — from TEST repo)
			local function isTargetInvincible(plr)
				if not plr then return false end
				-- 1) Roblox ForceField instance (spawn shield visual)
				local ch = plr.Character
				if ch then
					if ch:FindFirstChildOfClass("ForceField") or ch:FindFirstChild("ForceField") then
						return true
					end
				end
				-- 2) FighterController Entity.Data.IsInvincible (real Rivals check)
				local ok, inv = pcall(function()
					if not FighterController or not FighterController.Objects then return false end
					for _, fighterObj in FighterController.Objects do
						if fighterObj.Player == plr then
							local entity = fighterObj.Entity
							if not entity then return false end
							-- Entity:Get / Data.IsInvincible
							local data = nil
							pcall(function()
								if type(entity.Get) == "function" then
									data = entity:Get("Data")
								end
							end)
							if not data then
								pcall(function() data = entity.Data end)
							end
							if type(data) == "table" then
								if data.IsInvincible == true then return true end
								if type(data.Get) == "function" then
									local v = data:Get("IsInvincible")
									if v == true then return true end
								end
							end
							-- fighter-level helpers
							if type(fighterObj.IsInvincible) == "function" then
								if fighterObj:IsInvincible() then return true end
							elseif fighterObj.IsInvincible == true then
								return true
							end
							if type(entity.IsInvincible) == "function" then
								if entity:IsInvincible() then return true end
							end
							return false
						end
					end
					return false
				end)
				return ok and inv == true
			end
			if isTargetInvincible(targetPlayer) then
				getgenv().__NemesisHadEnemyFF = true
				pcall(function() setRageHud("ragebot: forcefield @" .. targetPlayer.Name) end)
				return
			end
			-- invincible / FF just cleared → shoot immediately
			if getgenv().__NemesisHadEnemyFF then
				getgenv().__NemesisHadEnemyFF = false
				getgenv().Config.ReadyAt = 0
				lastFire = 0
			end

			-- When voidspam: only fire in the attack window (hide window = OOB)
			if cfg.VoidSpam and not inFireWindow then
				return
			end

			if not lplr.Character or not lplr.Character:FindFirstChild("HumanoidRootPart") then return end
			if not FighterController or not FighterController.LocalFighter then return end

			-- swap when YOUR weapon is empty, then equip preferred/current slot
			pcall(function() autoSwitchIfEmpty(FighterController) end)
			local wantSlot = getSlotNumber()
			pcall(function()
				FighterController.LocalFighter:EquipItem(wantSlot)
			end)
			local item = FighterController.LocalFighter.EquippedItem
			if not item then
				pcall(function() FighterController.LocalFighter:EquipItem(wantSlot) end)
				item = FighterController.LocalFighter.EquippedItem
			end
			if not item then return end

			-- strip cooldowns so guns + melee all fire
			pcall(function()
				if item.Info then
					item.Info.AttackCooldown = 0
					item.Info.SwingCooldown = 0
					item.Info.MeleeCooldown = 0
					item.Info.Cooldown = 0
					item.Info.ShootCooldown = 0
					item.Info.FireRate = 0
					pcall(function() item.Info.Reloading = false end)
					pcall(function()
						if item.Info.Ammo ~= nil and item.Info.MaxAmmo ~= nil then
							item.Info.Ammo = item.Info.MaxAmmo
						end
					end)
				end
			end)

			local rate = tonumber(getgenv().Config.FireRate) or 0.0005
			if tick() - lastFire < rate then return end
			lastFire = tick()
			getgenv().__NemesisLastFire = lastFire
			getgenv().__NemesisLastShotTarget = targetPlayer

			local objectId
			pcall(function() objectId = item:Get("ObjectID") end)
			if not objectId then return end

			-- HEAD only + origin from top desync (works primary/secondary/melee)
			local originPos = desyncCF and desyncCF.Position or (targetHead.Position + Vector3.new(0, 1.2, 0))
			local targetPos = targetHead.Position
			local aimCF = CFrame.lookAt(originPos, targetPos)
			local targetCF = targetHead.CFrame
			local objSpaceHeadOffset = CFrame.new(0, 0, 0)

			-- FORCE HEAD ONLY FOR KNIFE
			local currentSlot = tostring(getgenv().Config.PreferredWeapon or getgenv().Config.WeaponSlot or "")
			local currentlyMelee = (currentSlot == "Melee" or currentSlot == "Knife") or getgenv().Config.KnifeRagebot or hasKnifeViewModel(targetPlayer)
			
			if currentlyMelee then
				local realHead = targetHead
				if realHead and realHead.Name ~= "HitboxHead" and realHead.Name ~= "HitboxHeadSmall" and realHead.Name ~= "PhysicalHitboxHead" then
					local ch = targetPlayer and targetPlayer.Character
					if ch then
						realHead = ch:FindFirstChild("HitboxHead") or ch:FindFirstChild("HitboxHeadSmall") or ch:FindFirstChild("PhysicalHitboxHead")
					end
				end
				if not realHead or (realHead.Name ~= "HitboxHead" and realHead.Name ~= "HitboxHeadSmall" and realHead.Name ~= "PhysicalHitboxHead") then
					pcall(function() setRageHud("waiting real head") end)
					return
				end
				targetHead = realHead
			end
			if not targetHead then
				pcall(function() setRageHud("waiting head") end)
				return
			end
			local cameradata = {}
			cameradata[utf8.char(1)] = {
				[utf8.char(0)] = util:EncodeCFrame(aimCF),
				[utf8.char(1)] = util:EncodeCFrame(targetCF),
				[utf8.char(2)] = targetHead,
				[utf8.char(3)] = util:EncodeCFrame(objSpaceHeadOffset),
			}

			pcall(function()
				local remote = repS.Remotes.Replication.Fighter.UseItem
				local shot = enum:ToEnum("StartShooting")
				local aim = enum:ToEnum("StartAiming")
				local slotName = tostring(getgenv().Config.PreferredWeapon or getgenv().Config.WeaponSlot or "")
				local knifeOn = (slotName == "Knife" or getgenv().Config.KnifeRagebot)

				if knifeOn then
					-- KNIFE RAGEBOT: melee slot + head only + HeavyAttack
					pcall(function() equipKnife(FighterController) end)
					pcall(function()
						local lf = FighterController.LocalFighter
						if lf and type(lf.Input) == "function" then
							lf:Input("StartAiming")
						end
					end)
					local heavy = enum:ToEnum("HeavyAttackAnimation1") or enum:ToEnum("HeavyAttack1")
					local atk = enum:ToEnum("AttackAnimation1") or enum:ToEnum("Attack1")
					local z0, z1, z2, z3 = utf8.char(0), utf8.char(1), utf8.char(2), utf8.char(3)
					for _ = 1, 20 do
						-- re-check head only
						local n = targetHead and tostring(targetHead.Name)
						if not n or (n ~= "HitboxHead" and n ~= "HitboxHeadSmall" and n ~= "PhysicalHitboxHead") then
							break
						end
						remote:FireServer(objectId, aim, {
							[z1] = cameradata[z1],
							[z2] = heavy,
						}, nil)
						remote:FireServer(objectId, shot, {
							[z1] = cameradata[z1],
							[z2] = atk,
						}, nil)
						remote:FireServer(objectId, shot, cameradata, nil)
					end
					setRageHud("ragebot: stabbing @" .. targetPlayer.Name)
					pcall(function()
						if Library and Library.Notify then
							Library:Notify("Hit @" .. targetPlayer.Name, 1.5)
						end
					end)
				else
					local bursts = 8
					if slotName == "Melee" then bursts = 12 end
					for _ = 1, bursts do
						remote:FireServer(objectId, shot, cameradata, nil)
					end
					setRageHud("ragebot: killing @" .. targetPlayer.Name)
					pcall(function()
						if Library and Library.Notify then
							Library:Notify("Hit @" .. targetPlayer.Name, 1.5)
						end
					end)
				end
			end)
		end)

		pcall(function() setRageHud("ragebot: idle") end)
		pcall(function() end) -- hit-only notifies
	end)

	if not ok then
		pcall(function() Library:Notify("Ragebot: " .. tostring(err)) end)
		stopRagebot()
	end
end

