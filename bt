			animator.Parent = hum
		end
		local id = resolveId()
		if not id then return end
		local anim = Instance.new("Animation")
		anim.AnimationId = "rbxassetid://" .. tostring(id)
		local ok, tr = pcall(function() return animator:LoadAnimation(anim) end)
		anim:Destroy()
		if not ok or not tr then return end
		track = tr
		track.Priority = Enum.AnimationPriority.Action4
		track.Looped = true
		pcall(function() track:Play() end)
		pcall(function() track:AdjustSpeed(tonumber(ap.Speed) or 1) end)
		loopConn = RunService.RenderStepped:Connect(function()
			if not getgenv().AnimPlayer.Enabled then stopAnim() return end
			if track and track.IsPlaying == false then
				pcall(function() track:Play() end)
			end
		end)
	end

