			if not isfile(Path) then
				local Ok, Data = pcall(game.HttpGet, game, 'https://raw.githubusercontent.com/scripter-sm/EliteZone/main/README/LargeTransparentLogo.png');
				if not Ok then return end;

				ensurefolder(EZ.Folder);
