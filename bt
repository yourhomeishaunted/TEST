			accent, tostring(Data.Rank or 'unranked'):lower(),
			accent, tostring(Data.Device or '?'),
			accent, tostring(Data.Streak or 0)
		);

		if Stats.Text ~= text then
			Stats.Text = text;
		end;

		local Health = Data.Health or 0;
		local MaxHealth = Data.MaxHealth or 100;
		text = math.floor(Health) .. ' / ' .. math.floor(MaxHealth);

		if HealthValue.Text ~= text then
			HealthValue.Text = text;
		end;

		local Scale = UDim2.fromScale(math.clamp(Health / MaxHealth, 0, 1), 1);
		if HealthFill.Size ~= Scale then
			HealthFill.Size = Scale;
		end;

		local Given = Data.DamageGiven or 0;
		local Taken = Data.DamageTaken or 0;
		text = ('%d <font color="#%s">▲</font>  %d <font color="#%s">▼</font>'):format(
			math.floor(Given + 0.5), UpColor:ToHex(),
			math.floor(Taken + 0.5), DownColor:ToHex()
		);

		if RatioValue.Text ~= text then
			RatioValue.Text = text;
		end;

		local Total = Given + Taken;
		local Ratio = Total > 0 and Given / Total or 0.5;
		Ratio = math.clamp(Ratio, 0, 1);
		Scale = UDim2.fromScale(Ratio, 1);

		if RatioFill.Size ~= Scale then
			RatioFill.Size = Scale;
			Seam.Position = UDim2.fromScale(Ratio, 0);
		end;
local Items = Data.Items;
		local MutedNow = Data.Placeholder or not Items;
		if MutedNow ~= Muted then
			Muted = MutedNow;
			MutedSize = Muted and UDim2.fromScale(0.85, 0.85)
				or UDim2.new(IconScale, -6 * IconScale, IconScale, -6 * IconScale);

			for Slot = 1, 4 do
				Icons[Slot].Size = MutedSize;
			end;
		end;

		local Tint = Muted and EZ.OutlineColor or Color3.new(1, 1, 1);

		for Index = 1, 4 do
			local Image = Items and Items[Index] or '';
			local Icon = Icons[Index];
			local Held = Data.Held and Data.Held[Index] or false;
			local Shade = Shades[Index];

			if Shade.Visible ~= Held then
				Shade.Visible = Held;
			end;

if Icon.Image ~= Image or Icon.ImageColor3 ~= Tint then
			Icon.Image = Image;
			Icon.ImageColor3 = Tint;
			Icon.Size = MutedSize;
		end;
		end;
	end;

	function HUD:SetVisible(Bool)
		Root.Visible = Bool;
	end;

	function HUD:SetScale(Amount)
		Scale.Scale = Amount;
	end;

	function HUD:SetIconScale(Amount)
		IconScale = Amount;
		MutedSize = Muted and UDim2.fromScale(0.85, 0.85)
			or UDim2.new(Amount, -6 * Amount, Amount, -6 * Amount);

		for Slot = 1, 4 do
			Icons[Slot].Size = MutedSize;
		end;
	end;

	function HUD:SetOffset(X, Y)
		Root.Position = UDim2.new(0.5, X, 0.5, Y);
	end;

	function HUD:SetFont(NewFont)
		if not NewFont then return end;
		Font = NewFont;
		for _, Item in next, Labels do
			Item.FontFace = Font;
		end;
	end;

	function HUD:SetFonts(NewFont, NewKey)
		if NewFont then
			Font = NewFont;
			Name.FontFace = NewFont;
			HealthLabel.FontFace = NewFont;
			HealthValue.FontFace = NewFont;
			RatioLabel.FontFace = NewFont;
			RatioValue.FontFace = NewFont;
		end;

		if NewKey then
			KeyFont = NewKey;
			Stats.FontFace = NewKey;
		end;
	end;

	function HUD:SetRound(Bool, Amount)
		Round = Bool and true or false;

		if Amount then
			Radius = Amount;
		end;

		for _, Inst in next, Rounded do
			local Corner = Inst:FindFirstChildOfClass('UICorner');

			if Round then
				if Corner then
					Corner.CornerRadius = UDim.new(0, Radius);
				else
					EZ:Create('UICorner', { CornerRadius = UDim.new(0, Radius); Parent = Inst; });
				end;
			elseif Corner then
				Corner:Destroy();
			end;
		end;
	end;

	function HUD:Remove()
		ScreenGui:Destroy();
		table.clear(HUD);
	end;

	return HUD;
end

