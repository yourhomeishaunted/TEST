local function getRageWeaponSlot()
	local cfg = getgenv().Config or {}
	local slot = tostring(cfg.PreferredWeapon or cfg.WeaponSlot or "Primary")
	if slot == "1" or slot:lower() == "primary" then return "Primary" end
	if slot == "2" or slot:lower() == "secondary" then return "Secondary" end
	if slot == "3" or slot:lower() == "melee" then return "Melee" end
	return slot
end

-- In-game HUD names by weapon:
-- Primary:   ragebot: void…
-- Secondary: ragebot: void @username
-- Melee:     ragebot: melee void…
local function formatRageHud(kind, username)
	local slot = getRageWeaponSlot()
	local name = username and tostring(username) or ""
	if kind == "idle" or not name or name == "" then
		if slot == "Melee" then return "ragebot: melee void…" end
		if slot == "Secondary" then return "ragebot: void" end
		return "ragebot: void…" -- Primary + default
	end
	-- active (voiding / killing / targeting)
	if slot == "Melee" then
		return "ragebot: melee void…"
	elseif slot == "Secondary" then
		return "ragebot: void @" .. name
	else
		return "ragebot: void…" -- Primary stays void… even with target
	end
end

