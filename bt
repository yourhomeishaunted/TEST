			TextTruncate = Enum.TextTruncate.AtEnd;
			ZIndex = 7;
			Parent = ItemClip;
		});

		EZ:OnHighlight(DropdownOuter, DropdownOuter,
			{ BorderColor3 = 'OutlineColor' },
