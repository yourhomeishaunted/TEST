do
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local UserInputService = game:GetService("UserInputService")
	local LP = Players.LocalPlayer

	local charCfg = {
		flyEnabled = false,
		flySpeed = 90,
		noclip = false,
		infJump = false,
		speedEnabled = false,
		walkSpeed = 32,
		jumpEnabled = false,
		jumpPower = 75,
		glideEnabled = false,
		glideSpeed = 280,
		glideAccel = 18,
		antiAfk = false,
	}

	local function getHrp()
		return LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	end

	local function getHum()
		return LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
	end

	-- Fly (camera-directed)
	local flyConn = nil
	local flyConn = nil
	local flyStepName = "NemesisFlyStep"

	local function startFly()
		pcall(function()
			if flyConn then flyConn:Disconnect() end
		end)
		flyConn = nil
		pcall(function()
			RunService:UnbindFromRenderStep(flyStepName)
		end)

		getgenv().NemesisFlyEnabled = true
		getgenv().charCfg = charCfg
		charCfg.flyEnabled = true
		charCfg.noclip = true

		local keys = {
			W = false, A = false, S = false, D = false,
			Up = false, Down = false,
		}

		local keyConn1, keyConn2
		pcall(function()
			keyConn1 = UserInputService.InputBegan:Connect(function(input, gp)
				if gp then return end
				local k = input.KeyCode
				if k == Enum.KeyCode.W then keys.W = true
				elseif k == Enum.KeyCode.A then keys.A = true
				elseif k == Enum.KeyCode.S then keys.S = true
				elseif k == Enum.KeyCode.D then keys.D = true
				elseif k == Enum.KeyCode.Space or k == Enum.KeyCode.E then keys.Up = true
				elseif k == Enum.KeyCode.LeftShift or k == Enum.KeyCode.Q then keys.Down = true
				end
			end)
			keyConn2 = UserInputService.InputEnded:Connect(function(input)
				local k = input.KeyCode
				if k == Enum.KeyCode.W then keys.W = false
				elseif k == Enum.KeyCode.A then keys.A = false
				elseif k == Enum.KeyCode.S then keys.S = false
				elseif k == Enum.KeyCode.D then keys.D = false
				elseif k == Enum.KeyCode.Space or k == Enum.KeyCode.E then keys.Up = false
				elseif k == Enum.KeyCode.LeftShift or k == Enum.KeyCode.Q then keys.Down = false
				end
			end)
		end)
		getgenv().__NemesisFlyKeyConns = { keyConn1, keyConn2 }

		local function step(dt)
			if not charCfg.flyEnabled or not getgenv().NemesisFlyEnabled then return end
			dt = typeof(dt) == "number" and dt or 0.016
			if dt <= 0 or dt > 0.1 then dt = 0.016 end

			local char = LP.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if not hrp then return end

			-- noclip + stay alive
			pcall(function()
				if hum then
					hum.PlatformStand = true
					hum.Sit = false
				end
				for _, p in ipairs(char:GetDescendants()) do
					if p:IsA("BasePart") then
						p.CanCollide = false
					end
				end
			end)

			local cam = workspace.CurrentCamera
			if not cam then return end

			local look = cam.CFrame.LookVector
			local right = cam.CFrame.RightVector
			local dir = Vector3.zero

			if keys.W then dir = dir + look end
			if keys.S then dir = dir - look end
			if keys.A then dir = dir - right end
			if keys.D then dir = dir + right end
			if keys.Up then dir = dir + Vector3.new(0, 1, 0) end
			if keys.Down then dir = dir - Vector3.new(0, 1, 0) end

			-- mobile / controller
			if dir.Magnitude < 0.05 and hum then
				local md = hum.MoveDirection
				if md.Magnitude > 0.05 then
					dir = md + Vector3.new(0, look.Y * md.Magnitude, 0)
				end
			end

			local speed = tonumber(charCfg.flySpeed) or 90
			if speed < 1 then speed = 90 end

			local vel = Vector3.zero
			if dir.Magnitude > 0.05 then
				vel = dir.Unit * speed
			end

			-- pure CFrame fly (works when BodyVelocity is deleted)
			local pos = hrp.Position + vel * dt
			hrp.CFrame = CFrame.new(pos, pos + look)
			pcall(function()
				hrp.AssemblyLinearVelocity = vel
				hrp.AssemblyAngularVelocity = Vector3.zero
			end)
		end

		-- bind high priority so it wins over other scripts
		pcall(function()
			RunService:BindToRenderStep(flyStepName, Enum.RenderPriority.Camera.Value - 1, step)
		end)
		flyConn = RunService.Heartbeat:Connect(step)

		pcall(function()
			Library:Notify("Fly ON — WASD + Space/Shift")
		end)
	end

	local function stopFly()
		getgenv().NemesisFlyEnabled = false
		charCfg.flyEnabled = false
		pcall(function()
			RunService:UnbindFromRenderStep(flyStepName)
		end)
		if flyConn then pcall(function() flyConn:Disconnect() end) flyConn = nil end
		pcall(function()
			local conns = getgenv().__NemesisFlyKeyConns
			if type(conns) == "table" then
				for _, c in pairs(conns) do
					pcall(function() c:Disconnect() end)
				end
			end
			getgenv().__NemesisFlyKeyConns = nil
		end)
		local hrp = getHrp()
		local hum = getHum()
		pcall(function()
			if hrp then
				hrp.AssemblyLinearVelocity = Vector3.zero
				hrp.AssemblyAngularVelocity = Vector3.zero
			end
			if hum then
				hum.PlatformStand = false
			end
		end)
		pcall(function() Library:Notify("Fly OFF") end)
	end

	-- Noclip
	RunService.Stepped:Connect(function()
		if not charCfg.noclip or not LP.Character then return end
		for _, p in ipairs(LP.Character:GetDescendants()) do
			if p:IsA("BasePart") then
				p.CanCollide = false
			end
		end
	end)

	-- Infinite jump
	UserInputService.JumpRequest:Connect(function()
		if not charCfg.infJump then return end
		local hum = getHum()
		if hum and hum:GetState() ~= Enum.HumanoidStateType.Dead then
			hum:ChangeState(Enum.HumanoidStateType.Jumping)
		end
	end)

	-- Walk speed / jump power apply
	RunService.Heartbeat:Connect(function()
