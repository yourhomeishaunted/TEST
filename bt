local function setRageHud(msg)
	-- disabled → hide on-screen HUD completely
	if not (getgenv().Config and getgenv().Config.Enabled) then
		hideRageHudScreen()
		return
	end
	local text = msg
	-- map old messages → weapon-based HUD names
	if not text or text == "" or text == "ragebot: idle" then
		text = formatRageHud("idle")
	else
		local user = text:match("@(.+)$")
		if text:find("voiding", 1, true) or text:find("killing", 1, true)
			or text:find("targeting", 1, true) or text:find("barrier", 1, true) then
			text = formatRageHud("active", user)
		elseif text:find("waiting", 1, true) or text:find("delay", 1, true) then
			text = formatRageHud("idle")
		else
			-- already custom or weapon-formatted
			if not text:find("ragebot:", 1, true) then
				text = formatRageHud("active", user or text)
			end
		end
	end
	if RageHudLabel then
		pcall(function()
			if type(RageHudLabel.SetText) == "function" then
				RageHudLabel:SetText(text)
			elseif RageHudLabel.Text then
				RageHudLabel.Text = text
			end
		end)
	end

	-- ON-SCREEN in-game HUD
	showRageHudScreen(text)

	if HudEnabled and tick() - lastNotify > 1.5 then
		lastNotify = tick()
		local custom = getgenv().NotifyText
		if custom and custom ~= "" then
			pcall(function() Library:Notify(custom .. " @" .. (text:match("@(.+)$") or "")) end)
		end
	end
end

