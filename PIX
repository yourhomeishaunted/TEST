if slotName == "Melee" then
						-- 1. Force the scanner to find the actual head hitbox
						local realHead = targetHead
						if realHead and realHead.Name ~= "HitboxHead" and realHead.Name ~= "HitboxHeadSmall" and realHead.Name ~= "PhysicalHitboxHead" then
							if targetPlayer and targetPlayer.Character then
								realHead = targetPlayer.Character:FindFirstChild("HitboxHead") 
									or targetPlayer.Character:FindFirstChild("HitboxHeadSmall") 
									or targetPlayer.Character:FindFirstChild("PhysicalHitboxHead")
							end
						end
						
						-- 2. If we actually have a head, swing
						if realHead then
							-- Perfect backstab position (0.5 studs behind, looking into the head)
							local backPos = realHead.Position - (realHead.CFrame.LookVector * 0.5) + Vector3.new(0, 0.2, 0)
							local headAimCF = CFrame.lookAt(backPos, realHead.Position)
							
							local naturalCamData = {
								[utf8.char(1)] = {
									[utf8.char(0)] = util:EncodeCFrame(headAimCF),
									[utf8.char(1)] = util:EncodeCFrame(realHead.CFrame),
									[utf8.char(2)] = realHead, -- Tells the server we aimed at the Head
									[utf8.char(3)] = util:EncodeCFrame(CFrame.new(0,0,0)),
								}
							}
							
							local heavy = enum:ToEnum("HeavyAttackAnimation1") or enum:ToEnum("HeavyAttack1")
							local atk = enum:ToEnum("AttackAnimation1") or enum:ToEnum("Attack1")
							local z1 = utf8.char(1)
							local z2 = utf8.char(2)
							
							-- 3. Start aiming so the scope opens
							pcall(function()
								local lf = FighterController.LocalFighter
								if lf and type(lf.Input) == "function" then
									lf:Input("StartAiming")
								end
							end)

							-- 4. Fire the heavy attack and regular attack directly to the head
							for _ = 1, 15 do
								pcall(function() remote:FireServer(objectId, enum:ToEnum("StartAiming"), {[z1] = naturalCamData[z1], [z2] = heavy}, nil) end)
								pcall(function() remote:FireServer(objectId, shot, {[z1] = naturalCamData[z1], [z2] = atk}, nil) end)
								pcall(function() remote:FireServer(objectId, shot, naturalCamData, nil) end)
							end
							
							setRageHud("ragebot: backstab head @" .. targetPlayer.Name)
						end
					end
