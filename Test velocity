					if vis then origin = Vector2.new(pos.X, pos.Y) end
				end
			end
			local r = math.max(Aimbot.FovRadius, 4)
			fovRing.Size = UDim2.fromOffset(r * 2, r * 2)
			fovRing.Position = UDim2.fromOffset(origin.X, origin.Y)
			fovRing.Visible = true
			fovStroke.Enabled = Aimbot.OutlineEnabled
			fovStroke.Thickness = Aimbot.OutlineEnabled and 2 or 1
