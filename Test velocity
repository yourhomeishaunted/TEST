					if typeof(state) == "Color3" then
						Content.State = state
						local h, s, v = Color3.toHSV(state)
						Content.Hue, Content.Sat, Content.Val = h, s, v
					end
					if transparency ~= nil then
						Content.Transparency = math.clamp(tonumber(transparency) or 0, 0, 1)
					end
					Holder_Outline_Frame.BackgroundColor3 = Content.State
					Holder_Outline_Frame.BackgroundTransparency = Content.Transparency
					Content.Callback(Content.State, Content.Transparency)
