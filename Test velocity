		pad.PaddingLeft = UDim.new(0, 8)
		pad.PaddingRight = UDim.new(0, 8)
		pad.Parent = list
		local function addRow(name, keyText)
			local row = Instance.new("Frame")
			row.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
			row.BackgroundTransparency = 0.35
			row.BorderSizePixel = 0
			row.Size = UDim2.new(1, 0, 0, 22)
			row.ZIndex = 102
			row.Parent = list
			local rCorner = Instance.new("UICorner")
			rCorner.CornerRadius = UDim.new(0, 4)
			rCorner.Parent = row
			local nLabel = Instance.new("TextLabel")
			nLabel.BackgroundTransparency = 1
			nLabel.Position = UDim2.new(0, 8, 0, 0)
			nLabel.Size = UDim2.new(0.6, -8, 1, 0)
			nLabel.Font = Enum.Font.Gotham
			nLabel.Text = name
			nLabel.TextColor3 = Color3.fromRGB(220, 220, 230)
			nLabel.TextSize = 11
			nLabel.TextXAlignment = Enum.TextXAlignment.Left
			nLabel.ZIndex = 103
			nLabel.Parent = row
			local kLabel = Instance.new("TextLabel")
			kLabel.BackgroundTransparency = 1
			kLabel.Position = UDim2.new(0.55, 0, 0, 0)
			kLabel.Size = UDim2.new(0.45, -8, 1, 0)
			kLabel.Font = Enum.Font.GothamBold
			kLabel.Text = keyText
			kLabel.TextColor3 = window.Accent or Color3.fromRGB(255, 255, 255)
			kLabel.TextSize = 11
			kLabel.TextXAlignment = Enum.TextXAlignment.Right
			kLabel.ZIndex = 103
			kLabel.Parent = row
			table.insert(KeybindMenu.Rows, {row = row, name = nLabel, key = kLabel})
		end
		local function refresh()
			for _, r in ipairs(KeybindMenu.Rows) do
				pcall(function() r.row:Destroy() end)
			end
			KeybindMenu.Rows = {}
			addRow("Menu Key", (function()
				local k = window.Key
				if typeof(k) == "EnumItem" then return k.Name end
				return "RightShift"
			end)())
			for idx, obj in pairs(Options) do
				if obj and obj.Mode ~= nil and obj.Active ~= nil and type(obj.Get) == "function" then
					local st = obj:Get()
					local keyStr = "-"
					if type(st) == "table" and st[2] then
						keyStr = tostring(st[2])
						if obj.Shorten then keyStr = obj:Shorten(keyStr) end
					end
					local displayName = obj.Name or idx
					addRow(tostring(displayName), keyStr)
				end
			end
		end
		refresh()
		KeybindMenu.Refresh = refresh
		gui.Enabled = KeybindMenu.Enabled
	end
