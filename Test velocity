		if type(data.weatherSpeed) == "number" then W.weatherSpeed = data.weatherSpeed end
		if type(data.weatherOpacity) == "number" then W.weatherOpacity = data.weatherOpacity end
		if type(data.weatherLightInfluence) == "number" then W.weatherLightInfluence = data.weatherLightInfluence end
	end

	local WORLD_SAVE = "velocity_world.json"
	local function saveWorld(W)
		local http = getHttp()
		if not http then return end
		local ok, encoded = pcall(function() return http:JSONEncode(serializeWorld(W)) end)
		if ok and type(encoded) == "string" then writeFile(WORLD_SAVE, encoded) end
	end
	local function loadWorld(W)
		local http = getHttp()
		if not http then return end
		local raw = readFile(WORLD_SAVE)
		if not raw then return end
		local ok, data = pcall(function() return http:JSONDecode(raw) end)
		if ok and type(data) == "table" then applyWorldData(W, data) end
	end

