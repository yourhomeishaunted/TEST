	local function layoutGrid(frame, list, query, selectedName, onClick, onRight)
		clearChildren(frame)
		local cols, pad, gap, tw, th = 6, 6, 6, 105, 100
		local i = 0
		for _, entry in ipairs(list) do
			if passes(entry, query) then
				local col = i % cols
				local row = math.floor(i / cols)
				local tile = makeTile(frame, entry, entry.Name == selectedName, onClick, onRight)
				tile.Position = UDim2.fromOffset(pad + col * (tw + gap), pad + row * (th + gap))
				i = i + 1
			end
		end
		local rows = math.max(1, math.ceil(i / cols))
		frame.CanvasSize = UDim2.fromOffset(0, pad * 2 + rows * (th + gap))
