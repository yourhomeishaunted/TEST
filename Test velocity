		local function getMuzzleScreen(cam)
			local char = lp and lp.Character
			if not char or not cam then return nil end
			local tool = char:FindFirstChildOfClass("Tool")
			local muzzle = tool and (tool:FindFirstChild("Muzzle") or tool:FindFirstChild("Barrel") or tool:FindFirstChildWhichIsA("Attachment", true))
			local part = muzzle and (muzzle:IsA("Attachment") and muzzle.Parent or muzzle)
			if part and part:IsA("BasePart") then
				local pos, vis = cam:WorldToViewportPoint(part.Position)
				if vis then return Vector2.new(pos.X, pos.Y) end
			end
			return nil
		end

		local function getFOVOrigin(targetPart)
			local cam = workspace.CurrentCamera
			local mode = FOV_MODES[SilentAim.FovMode] or "center"
			if mode == "position on target" and targetPart then
				local pos = targetPart.Position
				if typeof(pos) == "Vector3" then
					local sp, vis = cam:WorldToViewportPoint(pos)
					if vis then return Vector2.new(sp.X, sp.Y) end
				end
			end
			if mode == "position on barrel" then
				local muzzle = getMuzzleScreen(cam)
				if muzzle then return muzzle end
			end
			if cam then
				local vp = cam.ViewportSize
				return Vector2.new(vp.X * 0.5, vp.Y * 0.5)
			end
			return uis:GetMouseLocation()
		end

		local function getClosestPart(char, origin)
			local best, dist = nil, math.huge
			local cam = workspace.CurrentCamera
			if not cam then return nil end
			for _, part in ipairs(getAimParts(char)) do
				local pos, visible = cam:WorldToViewportPoint(part.Position)
				if visible and pos.Z > 0 then
					local d = (Vector2.new(pos.X, pos.Y) - origin).Magnitude
					if d < dist then
						best, dist = part, d
					end
				end
			end
			return best, dist
		end

		local function canSee(part)
			if not SilentAim.VisibleOnly then return true end
			local cam = workspace.CurrentCamera
			if not cam or not part then return false end
			local origin = cam.CFrame.Position
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			params.FilterDescendantsInstances = { lp.Character, workspace.CurrentCamera }
			params.IgnoreWater = true
			local result = workspace:Raycast(origin, (part.Position - origin), params)
			if not result then return true end
			return result.Instance:IsDescendantOf(part.Parent)
		end

		local function getTarget()
			SilentAim.SilentTargetPart = nil
			local cam = workspace.CurrentCamera
			if not cam then return nil end
			local origin = getFOVOrigin()
			local radius = math.max(SilentAim.Radius, 1)
			local best, bestDist, bestPart = nil, radius, nil
			local myRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")

			for _, plr in ipairs(players:GetPlayers()) do
				if plr ~= lp then
					local char = plr.Character
					local hum = char and char:FindFirstChildOfClass("Humanoid")
					local hrp = char and char:FindFirstChild("HumanoidRootPart")
					if char and hum and hum.Health > 0 and hrp then
						local skipTarget = false
						if SilentAim.LimitDistance and myRoot then
							if (hrp.Position - myRoot.Position).Magnitude > SilentAim.MaxDistance then
								skipTarget = true
							end
						end
						if not skipTarget then
						local part = char:FindFirstChild(SilentAim.TargetPart) or char:FindFirstChild("Head") or hrp
						local screenDist = 0
						local validPart = true
						if SilentAim.ClosestPart then
							local cp, d = getClosestPart(char, origin)
							if cp then part, screenDist = cp, d else validPart = false end
						else
							local pos, vis = cam:WorldToViewportPoint(part.Position)
							if not vis or pos.Z <= 0 then
								validPart = false
							else
								screenDist = (Vector2.new(pos.X, pos.Y) - origin).Magnitude
							end
						end
						if validPart and screenDist <= radius and canSee(part) then
							if screenDist < bestDist then
								bestDist = screenDist
								best = char
								bestPart = part
							end
						end
						end
					end
				end
			end

			local now = tick()
			if best then
				if best ~= SilentAim.CandidateTarget then
					SilentAim.CandidateTarget = best
					SilentAim.CandidateSince = now
				end
				local reaction = (SilentAim.ReactionTime or 0) / 1000
				if best == SilentAim.LockedTarget or now - SilentAim.CandidateSince >= reaction then
					SilentAim.LockedTarget = best
					SilentAim.LockedTargetPart = bestPart
					SilentAim.LastTargetSeen = now
				end
			else
				SilentAim.CandidateTarget = nil
			end

			local forget = SilentAim.ForgetTime or 0
			if SilentAim.LockedTarget and now - SilentAim.LastTargetSeen <= forget then
				local hum = SilentAim.LockedTarget:FindFirstChildOfClass("Humanoid")
				if hum and hum.Health > 0 and SilentAim.LockedTargetPart and SilentAim.LockedTargetPart.Parent == SilentAim.LockedTarget then
					SilentAim.SilentTargetPart = SilentAim.LockedTargetPart
					return SilentAim.LockedTarget
				end
			end

			if not best or best ~= SilentAim.LockedTarget then
				SilentAim.SilentTargetPart = nil
				return nil
			end
			SilentAim.SilentTargetPart = SilentAim.LockedTargetPart or bestPart
			return SilentAim.LockedTarget
		end

		local function isInCircleRange(target)
			if not SilentAim.ShowFov then return true end
			if not target then return false end
			local part = SilentAim.SilentTargetPart or target:FindFirstChild("Head")
			if not part then return false end
			local cam = workspace.CurrentCamera
			local pos, vis = cam:WorldToViewportPoint(part.Position)
			if not vis then return false end
			local mouse = getFOVOrigin()
			return (Vector2.new(pos.X, pos.Y) - mouse).Magnitude <= SilentAim.Radius
		end

