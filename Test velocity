		local function getClosestTarget()
			local cam = workspace.CurrentCamera
			if not cam then return nil end
			local radius = math.max(Aimbot.FovRadius, 1)
			local closest, closestScreen, closestWorld = nil, radius, math.huge
			local origin = getFOVOrigin()
			for _, plr in ipairs(players:GetPlayers()) do
				if isEnemyPlayer(plr) then
					local char = plr.Character
					local hum = char and char:FindFirstChildOfClass("Humanoid")
					if char and hum and hum.Health > 0 then
						local part = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
						if Aimbot.ClosestPart then
							local best = math.huge
							for _, aimPart in ipairs(getAimParts(char)) do
								local sp, vis = cam:WorldToViewportPoint(aimPart.Position)
								if vis and sp.Z > 0 then
									local d = (Vector2.new(sp.X, sp.Y) - origin).Magnitude
									if d < best then
										best = d
										part = aimPart
									end
								end
							end
						end
						if part then
							local pos, visible = cam:WorldToViewportPoint(part.Position)
							if visible and pos.Z > 0 then
								local screenDist = (Vector2.new(pos.X, pos.Y) - origin).Magnitude
								if screenDist <= radius then
									local worldDist = screenDist
									if Aimbot.ClosestPosition then
										local root = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
										local tRoot = char:FindFirstChild("HumanoidRootPart") or part
										if root and tRoot then
											worldDist = (tRoot.Position - root.Position).Magnitude
										end
										if worldDist < closestWorld then
											closestWorld = worldDist
											closest = { Player = plr, Character = char, Part = part, ScreenDistance = screenDist }
										end
									else
										if screenDist < closestScreen then
											closestScreen = screenDist
											closest = { Player = plr, Character = char, Part = part, ScreenDistance = screenDist }
										end
									end
								end
							end
						end
					end
				end
			end
			return closest
		end

		local function updateFovVisual()
