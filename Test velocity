				if p and p:IsA("BasePart") then
					table.insert(parts, p)
				end
			end
			return parts
		end

		local function getMuzzleScreen(cam)
			local char = lp and lp.Character
			if not char or not cam then return nil end
			local tool = char:FindFirstChildOfClass("Tool")
			local muzzle = tool and (tool:FindFirstChild("Muzzle") or tool:FindFirstChild("Barrel") or tool:FindFirstChildWhichIsA("Attachment", true))
			local part = muzzle and (muzzle:IsA("Attachment") and muzzle.Parent or muzzle)
			if part and part:IsA("BasePart") then
				local pos, vis = cam:WorldToViewportPoint(part.Position)
				if vis then return Vector2.new(pos.X, pos.Y) end
			end
			return nil
		end

		local function getFOVOrigin(targetPart)
			local cam = workspace.CurrentCamera
			local mode = FOV_MODES[Aimbot.FovMode] or "center"
			if mode == "position on target" and targetPart then
				local pos = targetPart.Position
				if typeof(pos) == "Vector3" then
					local sp, vis = cam:WorldToViewportPoint(pos)
					if vis then return Vector2.new(sp.X, sp.Y) end
				end
			end
			if mode == "position on barrel" then
				local muzzle = getMuzzleScreen(cam)
				if muzzle then return muzzle end
			end
			if cam then
				local vp = cam.ViewportSize
				return Vector2.new(vp.X * 0.5, vp.Y * 0.5)
			end
			return uis:GetMouseLocation()
		end

		local function isEnemyPlayer(plr)
			if not plr or plr == lp then return false end
			return true
