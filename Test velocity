		local function getPredictedPosition(part)
			if not part then return nil end
			local velocity = part.AssemblyLinearVelocity or Vector3.zero
			local lead = math.clamp(velocity.Magnitude / 350, 0, 0.12)
			local pred = part.Position + velocity * lead
			if math.abs(velocity.Y) > 2 then
				pred = pred + Vector3.new(0, velocity.Y * math.min(lead, 0.05), 0)
			end
			return pred
		end

		local function buildCameraData(fromPos, part)
			if not util or not part then return nil end
			local aimPosition = getPredictedPosition(part) or part.Position
			local look = CFrame.new(fromPos, aimPosition)
			local data = {}
			data[utf8.char(1)] = {
				[utf8.char(0)] = util:EncodeCFrame(look),
				[utf8.char(1)] = util:EncodeCFrame(look),
				[utf8.char(2)] = part,
				[utf8.char(3)] = util:EncodeCFrame(part.CFrame:ToObjectSpace(CFrame.new(aimPosition))),
			}
			return data
		end

		local function getShootFromPos(targetPart)
			local cam = workspace.CurrentCamera
			local fromPos = cam and cam.CFrame.Position or targetPart.Position
			if not SilentAim.Manipulation then
				return fromPos
			end
			return targetPart.Position + Vector3.new(0, 4, 0)
		end

		local function getAimParts(char)
			local parts = {}
			for _, name in ipairs(TARGET_PARTS) do
