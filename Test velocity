		local function makeDraggable(frame, _)
			local uis = game:GetService("UserInputService")
			local dragging, dragStart, startPos
			local preview = Instance.new("Frame")
			preview.Name = "DragOutline"
			preview.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
			preview.BackgroundTransparency = 0.82
			preview.BorderSizePixel = 0
			preview.Visible = false
			preview.ZIndex = (frame.ZIndex or 900) - 1
			preview.Parent = frame.Parent
			local pc = Instance.new("UICorner")
			pc.CornerRadius = UDim.new(0, 6)
			pc.Parent = preview
			local ps = Instance.new("UIStroke")
			ps.Color = Color3.fromRGB(255, 255, 255)
			ps.Thickness = 2
			ps.Parent = preview
			frame.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					dragging = true
					dragStart = input.Position
					startPos = frame.Position
					preview.Size = frame.Size
					preview.Position = frame.Position
					preview.AnchorPoint = frame.AnchorPoint
					preview.Visible = true
				end
			end)
			uis.InputChanged:Connect(function(input)
				if not dragging then return end
				if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
					local d = input.Position - dragStart
					preview.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
				end
			end)
			uis.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					if dragging then
						dragging = false
						frame.Position = preview.Position
						preview.Visible = false
					end
				end
			end)
		end
		
