		local function startAimbot()
			stopAimbot()
			Aimbot.RightHeld = not Aimbot.RequireRightClick
			if Aimbot.RequireRightClick then
				Aimbot.InputBegan = uis.InputBegan:Connect(function(input, gpe)
					if input.UserInputType == Enum.UserInputType.MouseButton2 then
						Aimbot.RightHeld = true
					end
				end)
				Aimbot.InputEnded = uis.InputEnded:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton2 then
						Aimbot.RightHeld = false
					end
				end)
			end
			Aimbot.Conn = RunService.RenderStepped:Connect(function(dt)
				if not Aimbot.Enabled then return end
				dt = math.clamp(dt or 0.016, 0.001, 0.05)
				updateFovVisual()
				if Aimbot.RequireRightClick and not Aimbot.RightHeld then
					Aimbot.LastTargetPosition = nil
					return
				end
				if window and window.MainFrame and window.MainFrame.Visible and window.Enabled then
					return
				end
				local ent = getClosestTarget()
				if not ent or not ent.Part then
					Aimbot.LastTargetPosition = nil
					return
				end
				local cam = workspace.CurrentCamera
				if not cam then return end
				local targetPosition = ent.Part.Position
				if Aimbot.DelayPosition then
					local vel = ent.Part.AssemblyLinearVelocity
					targetPosition = targetPosition + vel * math.clamp(Aimbot.Smoothing / 1000, 0, 0.25)
				end
				if Aimbot.JumpSmoothing and Aimbot.JumpSmoothing > 0 then
					local velY = ent.Part.AssemblyLinearVelocity.Y
					targetPosition = targetPosition + Vector3.new(0, velY * (Aimbot.JumpSmoothing / 100) * dt, 0)
				end
				Aimbot.LastTargetPosition = targetPosition

				local camPos = cam.CFrame.Position
				local toTarget = targetPosition - camPos
				if toTarget.Magnitude < 0.05 then return end
				local newDir = toTarget.Unit
				local facing = cam.CFrame.LookVector

				local diffYaw = wrapAngle(math.atan2(newDir.X, newDir.Z) - math.atan2(facing.X, facing.Z))
				local diffPitch = math.asin(math.clamp(newDir.Y, -1, 1)) - math.asin(math.clamp(facing.Y, -1, 1))

				local sens = 1
				pcall(function()
					sens = UserSettings():GetService("UserGameSettings").MouseSensitivity
				end)
				sens = math.clamp(sens, 0.05, 5)
				local moveConst = 0.022
				local angle = Vector2.new(diffYaw, -diffPitch) / (moveConst * sens)
				angle = Vector2.new(
					angle.X * (Aimbot.XSmooth / 100),
					angle.Y * (Aimbot.YSmooth / 100)
				)
				local scale = math.clamp((Aimbot.Smoothing / 100) * Aimbot.Lerp * dt * 12, 0.02, 1)
				angle = angle * scale

				local moved = moveMouseRel(angle.X, angle.Y)
				if not moved then
					pcall(function()
						local targetCF = CFrame.lookAt(camPos, camPos + newDir)
						cam.CFrame = cam.CFrame:Lerp(targetCF, math.clamp(scale * 0.35, 0.01, 0.35))
					end)
				end
			end)
			table.insert(library.Connections, Aimbot.Conn)
			if Aimbot.InputBegan then table.insert(library.Connections, Aimbot.InputBegan) end
			if Aimbot.InputEnded then table.insert(library.Connections, Aimbot.InputEnded) end
		end

