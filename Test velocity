		local RapidFireOriginals = {}
		local FastMeleeOriginals = {}
		local KnifeScytheOriginals = {}
		local ItemLibCache = nil
		local ItemLibFailAt = 0

		local RAPID_FIELDS = {
			"ShootSpread", "ShootAccuracy", "ShootRecoil",
			"ShootCooldown", "ShootBurstCooldown",
		}
		local RAPID_VALUES = {
			ShootSpread = 0,
			ShootAccuracy = 0,
			ShootRecoil = 0,
			ShootCooldown = 0.001,
			ShootBurstCooldown = 0.001,
		}
		local MELEE_FIELDS = {
			"AttackCooldown", "SwingCooldown", "MeleeCooldown", "Cooldown",
			"RecoveryTime", "ResetTime",
		}
		local KNIFE_FIELDS = {
			"Cooldown", "AttackCooldown", "UseDelay", "SpinCooldown",
			"HeavyAttackCooldown", "AbilityCooldown", "FireCooldown", "DashCooldown",
			"BackstabCooldown", "KnifeCooldown", "ScytheCooldown",
		}

		local function getItemLibrary()
			if ItemLibCache then return ItemLibCache end
			if tick() - ItemLibFailAt < 2 then return nil end
			local ok, lib = pcall(function()
				local mods = game:GetService("ReplicatedStorage"):FindFirstChild("Modules")
				local itemLib = mods and mods:FindFirstChild("ItemLibrary")
				if not itemLib then return nil end
				return require(itemLib)
			end)
			if ok and type(lib) == "table" then
				ItemLibCache = lib
				return lib
			end
			ItemLibFailAt = tick()
			return nil
		end

		local function iterItemTables(library)
			local out = {}
			if type(library) ~= "table" then return out end
			local categories = {
				library.Items, library.Weapons, library.Melee,
				library.Primary, library.Secondary, library.Utility,
			}
			for _, items in ipairs(categories) do
				if type(items) == "table" then
					table.insert(out, items)
				end
			end
			if #out == 0 and type(library) == "table" then
				for _, v in pairs(library) do
					if type(v) == "table" and (v.ShootCooldown ~= nil or v.AttackCooldown ~= nil or v.Cooldown ~= nil) then
						table.insert(out, library)
						break
					end
				end
			end
			return out
		end

		local function cacheAndSet(store, item, field, value)
			if type(item) ~= "table" then return end
			local cur = item[field]
			if cur == nil then return end
			if store[item] == nil then store[item] = {} end
			if store[item][field] == nil then
				store[item][field] = cur
			end
			item[field] = value
		end

		local function restoreStore(store)
			for item, fields in pairs(store) do
				if type(item) == "table" and type(fields) == "table" then
					for field, value in pairs(fields) do
						pcall(function() item[field] = value end)
					end
				end
			end
			table.clear(store)
		end

		local function applyRapidFire()
			local library = getItemLibrary()
			if not library then return false end
			local tables = iterItemTables(library)
			for _, items in ipairs(tables) do
				for _, data in pairs(items) do
					if type(data) == "table" then
						for _, field in ipairs(RAPID_FIELDS) do
							local val = RAPID_VALUES[field]
							if data[field] ~= nil then
								cacheAndSet(RapidFireOriginals, data, field, val)
							end
						end
					end
				end
			end
			return true
		end

		local function applyFastMelee()
			local library = getItemLibrary()
			if not library then return false end
			local tables = iterItemTables(library)
			for _, items in ipairs(tables) do
				for _, data in pairs(items) do
					if type(data) == "table" then
						for _, field in ipairs(MELEE_FIELDS) do
							if data[field] ~= nil then
								cacheAndSet(FastMeleeOriginals, data, field, 0.001)
							end
						end
					end
				end
			end
			return true
		end

		local function applyNoKnifeScytheCd()
			local library = getItemLibrary()
			if not library then return false end
			local tables = iterItemTables(library)
			for _, items in ipairs(tables) do
				for name, data in pairs(items) do
					if type(data) == "table" then
						local n = tostring(name):lower()
						local isTarget = n:find("knife", 1, true) or n:find("scythe", 1, true)
							or n:find("backstab", 1, true) or n:find("dagger", 1, true)
						for _, field in ipairs(KNIFE_FIELDS) do
							if data[field] ~= nil then
								cacheAndSet(KnifeScytheOriginals, data, field, 0)
							end
						end
						if isTarget and type(data.Info) == "table" then
							local info = data.Info
							for _, field in ipairs(KNIFE_FIELDS) do
								if info[field] ~= nil then
									cacheAndSet(KnifeScytheOriginals, info, field, 0)
								end
							end
							if info.DashCooldown ~= nil then
								cacheAndSet(KnifeScytheOriginals, info, "DashCooldown", 0)
							end
						end
					end
				end
			end
			return true
		end

		local reapplyConn
		local function syncReapplyLoop()
			if reapplyConn then return end
			reapplyConn = RunService.Heartbeat:Connect(function()
				if not (GunMod.RapidFire or GunMod.FastMelee or GunMod.NoKnifeScytheCd) then
					return
				end
				local t = tick()
				if GunMod._nextReapply and t < GunMod._nextReapply then return end
				GunMod._nextReapply = t + 1.5
				if GunMod.RapidFire then pcall(applyRapidFire) end
				if GunMod.FastMelee then pcall(applyFastMelee) end
				if GunMod.NoKnifeScytheCd then pcall(applyNoKnifeScytheCd) end
			end)
			table.insert(library.Connections, reapplyConn)
		end

		gunModSec:CreateToggle({
			Name = "rapid fire",
			State = false,
			Callback = function(v)
				GunMod.RapidFire = v == true
				if GunMod.RapidFire then
					local ok = applyRapidFire()
					syncReapplyLoop()
					SaveManager:Notify(ok and "rapid fire on" or "item library not ready", 1.5)
				else
					restoreStore(RapidFireOriginals)
					SaveManager:Notify("rapid fire off", 1.2)
				end
			end
		})

		gunModSec:CreateToggle({
			Name = "fast melee",
			State = false,
			Callback = function(v)
				GunMod.FastMelee = v == true
				if GunMod.FastMelee then
					local ok = applyFastMelee()
					syncReapplyLoop()
					SaveManager:Notify(ok and "fast melee on" or "item library not ready", 1.5)
				else
					restoreStore(FastMeleeOriginals)
					SaveManager:Notify("fast melee off", 1.2)
				end
			end
		})

		gunModSec:CreateToggle({
			Name = "no scythe/knife cooldown",
			State = false,
			Callback = function(v)
				GunMod.NoKnifeScytheCd = v == true
				if GunMod.NoKnifeScytheCd then
					local ok = applyNoKnifeScytheCd()
					syncReapplyLoop()
					SaveManager:Notify(ok and "knife/scythe cd off" or "item library not ready", 1.5)
				else
					restoreStore(KnifeScytheOriginals)
					SaveManager:Notify("knife/scythe cd restored", 1.2)
				end
			end
		})
	end

	do
		local SoundService = game:GetService("SoundService")
		local Debris = game:GetService("Debris")

		local HitSounds = {
			Enabled = false,
			RemoveDefault = false,
			Volume = 0.5,
			SoundIndex = 1,
			CustomId = "",
			Hooked = false,
			OriginalPlayHitmarkerSound = nil,
		}

		local SOUND_NAMES = {
			"neverlose", "gamesense", "skeet", "rust", "bell",
			"bubble", "minecraft", "osu", "tf2", "custom",
		}
		local SOUND_IDS = {
			neverlose = "rbxassetid://6607204501",
			gamesense = "rbxassetid://4817809188",
			skeet = "rbxassetid://5447626464",
			rust = "rbxassetid://5043539486",
			bell = "rbxassetid://6534947240",
			bubble = "rbxassetid://6534947588",
			minecraft = "rbxassetid://4018616850",
			osu = "rbxassetid://7149255551",
			tf2 = "rbxassetid://2868331684",
			custom = "",
		}

		local function resolveSoundId(name)
			name = tostring(name or "neverlose"):lower()
			local id = SOUND_IDS[name] or ""
			if name == "custom" then
				id = tostring(HitSounds.CustomId or "")
			end
			if id == "" or name == "disable" then return nil end
			if not id:find("rbxassetid://", 1, true) then
				id = "rbxassetid://" .. tostring(id):gsub("%D", "")
			end
			if id == "rbxassetid://" then return nil end
			return id
		end

		local function playHitSound(name, volume, speed, startAt)
			local id = resolveSoundId(name)
			if not id then return end
			local sound = Instance.new("Sound")
			sound.Name = "__VelocityHitSound"
			pcall(function()
				sound:SetAttribute("__VelocityHitSound", true)
				sound:SetAttribute("__VelocityCustomSound", true)
			end)
			sound.SoundId = id
			sound.Volume = math.clamp(tonumber(volume) or HitSounds.Volume or 0.5, 0, 10)
			sound.PlaybackSpeed = math.clamp(tonumber(speed) or 1, 0.1, 5)
			sound.TimePosition = math.max(tonumber(startAt) or 0, 0)
			sound.Parent = SoundService
			sound:Play()
			Debris:AddItem(sound, 5)
		end

		local function currentSoundName()
			return SOUND_NAMES[HitSounds.SoundIndex] or "neverlose"
		end

		local function installHitSoundHook()
			local ok, viewmodelModule = pcall(function()
				return require(lp.PlayerScripts.Modules.ClientReplicatedClasses.ClientFighter.ClientItem.ClientViewModel)
			end)
			if not ok or type(viewmodelModule) ~= "table" or type(viewmodelModule.PlayHitmarkerSound) ~= "function" then
				return false
			end
			if not HitSounds.OriginalPlayHitmarkerSound then
				HitSounds.OriginalPlayHitmarkerSound = viewmodelModule.PlayHitmarkerSound
			end
			viewmodelModule.PlayHitmarkerSound = function(self, crit, divisor, ...)
				if HitSounds.Enabled then
					playHitSound(currentSoundName(), HitSounds.Volume, 1, 0)
				end
				if HitSounds.RemoveDefault then
					return
				end
				if HitSounds.OriginalPlayHitmarkerSound then
					return HitSounds.OriginalPlayHitmarkerSound(self, crit, divisor, ...)
				end
			end
			HitSounds.Hooked = true
			return true
		end

		local function restoreHitSoundHook()
			if not HitSounds.OriginalPlayHitmarkerSound then return end
			pcall(function()
				local viewmodelModule = require(lp.PlayerScripts.Modules.ClientReplicatedClasses.ClientFighter.ClientItem.ClientViewModel)
				if type(viewmodelModule) == "table" then
					viewmodelModule.PlayHitmarkerSound = HitSounds.OriginalPlayHitmarkerSound
				end
			end)
			HitSounds.Hooked = false
		end

		local function syncHitSoundHook()
			if HitSounds.Enabled or HitSounds.RemoveDefault then
				if not installHitSoundHook() then
					task.delay(1, function()
						if HitSounds.Enabled or HitSounds.RemoveDefault then
							installHitSoundHook()
						end
					end)
				end
			else
				restoreHitSoundHook()
			end
		end

		table.insert(library.Connections, {
			Disconnect = function()
				HitSounds.Enabled = false
				HitSounds.RemoveDefault = false
				restoreHitSoundHook()
			end
