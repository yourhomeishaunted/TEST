		img.BackgroundTransparency = 1
		img.BorderSizePixel = 0
		img.Size = UDim2.fromOffset(40, 20)
		img.AnchorPoint = Vector2.new(0.5, 0)
		img.ScaleType = Enum.ScaleType.Fit
		img.ZIndex = 5
		img.Visible = false
		img.Parent = espGui
		o.wepImg = img
		o.skel = {}
		for i = 1, #SKEL_R15 do
			o.skel[i] = { out = espFrame(1), line = espFrame(2) }
		end
		ESP.Objects[plr] = o
		return o
	end
	local function espHide(o)
		for _, k in ipairs(ESP_KEYS) do o[k].Visible = false end
		for _, s in ipairs(o.skel) do
			s.out.Visible = false
			s.line.Visible = false
		end
	end
	local function espDestroy(plr)
		local o = ESP.Objects[plr]
		if not o then return end
		for _, k in ipairs(ESP_KEYS) do pcall(function() o[k]:Destroy() end) end
		for _, s in ipairs(o.skel) do
			pcall(function() s.out:Destroy() end)
			pcall(function() s.line:Destroy() end)
		end
		ESP.Objects[plr] = nil
	end
	local function espHealthColor(f)
		local c = ESP.Colors
		if f > 0.5 then return c.HealthMid:Lerp(c.HealthHigh, (f - 0.5) * 2) end
		return c.HealthLow:Lerp(c.HealthMid, f * 2)
	end

	utility:CreateConnection(RunService.RenderStepped, function()
		local cam = WorkspaceSvc.CurrentCamera
		if not ESP.Enabled or not cam then
			for _, o in pairs(ESP.Objects) do espHide(o) end
			return
		end
		local font = Enum.Font[ESP.Fonts[ESP.FontIndex] or "Code"]
		for _, plr in ipairs(players:GetPlayers()) do
			if plr ~= lp then
				local o = ESP.Objects[plr]
				local char = plr.Character
				local hrp = char and char:FindFirstChild("HumanoidRootPart")
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				local show = hrp ~= nil and hum ~= nil and hum.Health > 0
				if show and ESP.TeamCheck and plr.Team ~= nil and plr.Team == lp.Team then show = false end
				local top, bot
				if show then
					local onScreen
					top, onScreen = cam:WorldToViewportPoint(hrp.Position + Vector3.new(0, 2.9, 0))
					bot = cam:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3.1, 0))
					show = onScreen and top.Z > 0 and bot.Z > 0
				end
				if not show then
					if o then espHide(o) end
				else
					o = o or espNew(plr)
					local h = math.max(math.abs(bot.Y - top.Y), 4)
					local w = h * 0.55
					local cx, x, y = top.X, top.X - w / 2, top.Y
					if ESP.Boxes then
						o.boxOut.Position = UDim2.fromOffset(x, y)
						o.boxOut.Size = UDim2.fromOffset(w, h)
						o.boxOut.Visible = true
						o.box.Position = UDim2.fromOffset(x, y)
						o.box.Size = UDim2.fromOffset(w, h)
						o.boxStroke.Color = ESP.Colors.Boxes
						o.box.Visible = true
					else
						o.boxOut.Visible = false
						o.box.Visible = false
					end
					if ESP.Name then
						o.name.Font = font
						o.name.Text = plr.DisplayName
						o.name.TextColor3 = ESP.Colors.Name
						o.name.Position = UDim2.fromOffset(cx, y - 14)
						o.name.Visible = true
					else
						o.name.Visible = false
					end
					local by = y + h + 2
					if ESP.Distance then
						local myRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
						local dist = myRoot and (myRoot.Position - hrp.Position).Magnitude or 0
						o.dist.Font = font
						o.dist.Text = math.floor(dist) .. "m"
						o.dist.TextColor3 = ESP.Colors.Distance
						o.dist.Position = UDim2.fromOffset(cx, by)
						o.dist.Visible = true
						by = by + 12
					else
						o.dist.Visible = false
					end
					local tool = char:FindFirstChildOfClass("Tool")
					if tool and table.find(ESP.WeaponModes, 1) then
						o.weapon.Font = font
						o.weapon.Text = tool.Name
						o.weapon.TextColor3 = ESP.Colors.Weapon
						o.weapon.Position = UDim2.fromOffset(cx, by)
						o.weapon.Visible = true
						by = by + 12
					else
						o.weapon.Visible = false
					end
					if tool and table.find(ESP.WeaponModes, 2) and tool.TextureId ~= "" then
						o.wepImg.Image = tool.TextureId
						o.wepImg.ImageColor3 = ESP.Colors.Weapon
						o.wepImg.Position = UDim2.fromOffset(cx, by)
						o.wepImg.Visible = true
					else
						o.wepImg.Visible = false
					end
					if ESP.Health then
						local f = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
						local bx = x - 6
						o.hpBg.Position = UDim2.fromOffset(bx - 1, y - 1)
						o.hpBg.Size = UDim2.fromOffset(4, h + 2)
						o.hpBg.Visible = true
						o.hpFill.BackgroundColor3 = espHealthColor(f)
						o.hpFill.Position = UDim2.fromOffset(bx, y + h * (1 - f))
						o.hpFill.Size = UDim2.fromOffset(2, math.max(h * f, 1))
						o.hpFill.Visible = true
						if ESP.HealthNumbers then
							o.hpNum.Font = font
							o.hpNum.Text = tostring(math.floor(hum.Health))
							o.hpNum.TextColor3 = espHealthColor(f)
							o.hpNum.Position = UDim2.fromOffset(bx - 4, y + h * (1 - f))
							o.hpNum.Visible = true
						else
							o.hpNum.Visible = false
						end
					else
						o.hpBg.Visible = false
						o.hpFill.Visible = false
						o.hpNum.Visible = false
					end
					local list = char:FindFirstChild("UpperTorso") and SKEL_R15 or SKEL_R6
					for i, s in ipairs(o.skel) do
						local pr = list[i]
						local pa = pr and char:FindFirstChild(pr[1])
						local pb = pr and char:FindFirstChild(pr[2])
						local drawn = false
						if ESP.Skeleton and pa and pb then
							local a = cam:WorldToViewportPoint(pa.Position)
							local b = cam:WorldToViewportPoint(pb.Position)
							if a.Z > 0 and b.Z > 0 then
								local va, vb = Vector2.new(a.X, a.Y), Vector2.new(b.X, b.Y)
								s.line.BackgroundColor3 = ESP.Colors.Skeleton
								espLine(s.line, va, vb, 1)
								if ESP.SkeletonOutline then
									espLine(s.out, va, vb, 3)
								else
									s.out.Visible = false
								end
								drawn = true
							end
						end
						if not drawn then
							s.line.Visible = false
							s.out.Visible = false
						end
					end
				end
			end
		end
	end)
