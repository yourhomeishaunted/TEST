	local function espLine(f, a, b, thickness)
		local d = b - a
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Size = UDim2.fromOffset(d.Magnitude, thickness)
		f.Position = UDim2.fromOffset((a.X + b.X) / 2, (a.Y + b.Y) / 2)
		f.Rotation = math.deg(math.atan2(d.Y, d.X))
		f.Visible = true
	end
	local function espNew(plr)
		local o = {}
		o.boxOut = espBox(1, 3)
		o.box, o.boxStroke = espBox(2, 1)
		o.name = espText()
		o.dist = espText()
		o.weapon = espText()
		o.hpNum = espText(Vector2.new(1, 0.5))
		o.hpNum.Size = UDim2.fromOffset(30, 12)
		o.hpNum.TextXAlignment = Enum.TextXAlignment.Right
		o.hpBg = espFrame(2)
