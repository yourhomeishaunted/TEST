		local function updateSaFov()
			local show = SilentAim.Enabled and SilentAim.ShowFov
			if not show then
				saRing.Visible = false
				return
			end
			local origin = getFOVOrigin(SilentAim.SilentTargetPart)
			local r = math.max(SilentAim.Radius, 4)
			saRing.Size = UDim2.fromOffset(r * 2, r * 2)
			saRing.Position = UDim2.fromOffset(origin.X, origin.Y)
			saRing.Visible = true
			saStroke.Enabled = SilentAim.Outline
			saFill.Visible = SilentAim.Fill == true
			local rotation = SilentAim.Rotation or 0
			if SilentAim.MovingRotation then
				rotation = rotation + os.clock() * 360 * (SilentAim.RotationSpeed or 1)
			end
			saStrokeGrad.Rotation = rotation
			saGlowGrad.Rotation = rotation
			saFillGrad.Rotation = rotation
			refreshSaColors()
		end

		local function tryAutoReload(item, fighter)
			if not SilentAim.AutoReload or not item or not fighter then return false end
			local ok, empty = pcall(function()
				local ammo = item.Get and item:Get("Ammo")
				return ammo == 0
			end)
			if ok and empty then
				pcall(function()
					local remote = getUseItemRemote()
					if remote and enums then
						remote:FireServer(item:Get("ObjectID"), enums:ToEnum("Reload"), nil, nil)
					end
				end)
				return true
			end
			return false
		end

		local function installSilentHook()
			if SilentAim.Hooked then return true end
			if not hookfunction or not newcclosure then
				warn("[Silent Aim] hookfunction/newcclosure unavailable")
				return false
			end
			local remote = getUseItemRemote()
			if not remote then
				warn("[Silent Aim] UseItem remote not found")
				return false
			end
			if not enums or not util then
				pcall(function()
					local rs = game:GetService("ReplicatedStorage")
					util = require(rs.Modules.Utility)
					enums = require(rs.Modules.EnumLibrary)
				end)
			end
			if not enums or not util then
				warn("[Silent Aim] Utility/EnumLibrary missing")
				return false
			end

			local ok, err = pcall(function()
				SilentAim.OldFireServer = hookfunction(
					remote.FireServer,
					newcclosure(function(self, obj, action, cameradata, ...)
						if SilentAim.Enabled and enums and action == enums:ToEnum("StartShooting") then
							if rand:NextNumber(0, 100) > SilentAim.HitChance then
								return SilentAim.OldFireServer(self, obj, action, cameradata, ...)
							end
							local fighter = getFighter()
							local item = fighter and fighter.EquippedItem
							if tryAutoReload(item, fighter) then
								return nil
							end
							local target = getTarget()
							if target and isInCircleRange(target) then
								local targetPart = SilentAim.SilentTargetPart
								if not targetPart and SilentAim.ClosestPart then
									targetPart = select(1, getClosestPart(target, getFOVOrigin()))
								end
								if not targetPart then
									if rand:NextNumber(0, 100) <= SilentAim.HeadshotChance then
										targetPart = target:FindFirstChild("Head")
									else
										targetPart = target:FindFirstChild("HumanoidRootPart")
									end
								end
								targetPart = targetPart or target:FindFirstChild("Head") or target:FindFirstChild("HumanoidRootPart")
								if targetPart then
									local fromPos = getShootFromPos(targetPart)
									local newData = buildCameraData(fromPos, targetPart)
									if newData then
										cameradata = newData
									end
								end
							end
						end
						return SilentAim.OldFireServer(self, obj, action, cameradata, ...)
					end)
				)
			end)
			if not ok then
				warn("[Silent Aim] hook failed:", err)
				return false
			end
			SilentAim.Hooked = true
			return true
		end

		local function stopSilentAim()
			if SilentAim.Conn then pcall(function() SilentAim.Conn:Disconnect() end); SilentAim.Conn = nil end
			if SilentAim.AutoFireConn then pcall(function() SilentAim.AutoFireConn:Disconnect() end); SilentAim.AutoFireConn = nil end
			saRing.Visible = false
			SilentAim.LockedTarget = nil
			SilentAim.SilentTargetPart = nil
		end

		local function startSilentAim()
			stopSilentAim()
			installSilentHook()
			SilentAim.Conn = RunService.RenderStepped:Connect(function()
				if not SilentAim.Enabled then return end
				updateSaFov()
				if SilentAim.AutoFire then
					local target = getTarget()
					if target and isInCircleRange(target) then
						pcall(function()
							local fighter = getFighter()
							local item = fighter and fighter.EquippedItem
							if not item then return end
							local remote = getUseItemRemote()
							if not remote or not enums then return end
							local objectId = item.Get and item:Get("ObjectID")
							if not objectId then return end
							local part = SilentAim.SilentTargetPart or target:FindFirstChild("Head")
							if not part then return end
							local fromPos = getShootFromPos(part)
							local data = buildCameraData(fromPos, part)
							remote:FireServer(objectId, enums:ToEnum("StartShooting"), data, nil)
						end)
					end
				end
			end)
			table.insert(library.Connections, SilentAim.Conn)
		end

