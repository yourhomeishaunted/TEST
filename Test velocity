	local function hitNotifySafeTableGet(tab, key)
		if typeof(tab) ~= "table" then return nil end
		local ok, val = pcall(rawget, tab, key)
		return ok and val or nil
	end
	local function hitNotifyFindInValues(tab, callback)
		local found
		pcall(function()
			for _, value in pairs(tab) do
				found = callback(value)
				if found ~= nil then return end
			end
		end)
		return found
	end
	local function hitNotifyGetCharacter(inst)
		local current = inst
		while current and current ~= workspace do
			if current:IsA("Model") then
				local hum = current:FindFirstChildOfClass("Humanoid") or current:FindFirstChild("EnemyHumanoid")
				if hum or players:GetPlayerFromCharacter(current) then
					return current
				end
			end
			current = current.Parent
		end
		return nil
	end
	local function hitNotifyGetPartName(inst)
		if not inst then return "Unknown" end
		local name = inst.Name
		if name == "HitboxHead" or name == "HitboxHeadSmall" or name == "Head" then return "Head" end
		if name == "HitboxBody" or name == "HitboxBodySmall" then return "Body" end
		return name
	end
	local function hitNotifyGetDamageValue(data, depth)
		if type(data) == "number" and data > 0 and data <= 1000 then return data end
		if depth > 6 or typeof(data) ~= "table" then return nil end
		local direct = hitNotifySafeTableGet(data, utf8.char(0))
			or hitNotifySafeTableGet(data, "Damage")
			or hitNotifySafeTableGet(data, "damage")
			or hitNotifySafeTableGet(data, "Amount")
			or hitNotifySafeTableGet(data, "amount")
			or hitNotifySafeTableGet(data, "DamageAmount")
			or hitNotifySafeTableGet(data, "damageAmount")
			or hitNotifySafeTableGet(data, "HealthRemoved")
			or hitNotifySafeTableGet(data, "healthRemoved")
		if type(direct) == "number" and direct > 0 then return direct end
		local nested = hitNotifyFindInValues(data, function(child)
			if typeof(child) == "table" then
				return hitNotifyGetDamageValue(child, depth + 1)
			end
		end)
		if nested then return nested end
		return hitNotifyFindInValues(data, function(child)
			if type(child) == "number" and child > 0 and child <= 500 then return child end
		end)
	end
	local function hitNotifyFindDamageTarget(value, depth)
		if depth > 6 then return nil end
		if typeof(value) == "Instance" then
			local character = hitNotifyGetCharacter(value)
			if character and character ~= (lp and lp.Character) then
				return value, character
			end
			return nil
		end
		if typeof(value) ~= "table" then return nil end
		local found = hitNotifyFindInValues(value, function(child)
			local part, character = hitNotifyFindDamageTarget(child, depth + 1)
			if part then return { part, character } end
		end)
		if found then return found[1], found[2] end
		return nil
	end
	local function hitNotifyGetWeaponName()
		local ok, name = pcall(function()
			local fighterController = require(lp.PlayerScripts.Controllers.FighterController)
			local fighter = fighterController.LocalFighter or fighterController:GetFighter(lp)
			local item = fighter and fighter.EquippedItem
			if not item then return "Unknown" end
			if type(item.Get) == "function" then
				return item:Get("Name") or item:Get("ItemName") or item:Get("WeaponName")
			end
			return item.Name or (item.Info and item.Info.Name)
		end)
		return ok and tostring(name or "Unknown") or "Unknown"
	end
	local function hitNotifyBuildMessage(playerName, damage, part)
		local format = tostring(HitNotify.Message or "")
		if format == "" then
			format = "Hit {NAME} for {DMG} in the {PART}"
		end
		local weapon = hitNotifyGetWeaponName()
		return format
			:gsub("{DNAME}", playerName)
			:gsub("{NAME}", playerName)
			:gsub("{DMG}", damage)
			:gsub("{PART}", part)
			:gsub("{WEAPON}", weapon)
			:gsub("{player}", playerName)
			:gsub("{damage}", damage)
			:gsub("{part}", part)
			:gsub("{weapon}", weapon)
	end

	local function hitNotifyMarkAttack(targetModel)
		local now = tick()
		HitNotifyState.LastShotAt = now
		HitNotifyState.LastAttackAt = now
		if targetModel then
			HitNotifyState.LastTargetCharacter = targetModel
			HitNotifyState.LastTargetUntil = now + 1.35
		end
	end

	local function hitNotifyEmit(targetModel, damage, partName, fromConfirmedHit)
		if not HitNotify.Enabled then return end
		if not damage or damage <= 0 then return end
		if not targetModel then return end
		local now = tick()
		local player = players:GetPlayerFromCharacter(targetModel)
		if player == lp then return end
		if targetModel == (lp and lp.Character) then return end

		if not fromConfirmedHit then
			local recent = now - (HitNotifyState.LastShotAt or 0) <= 1.35
				or now - (HitNotifyState.LastAttackAt or 0) <= 1.35
			if not recent then return end
			local lastTarget = HitNotifyState.LastTargetCharacter
			if lastTarget and lastTarget ~= targetModel then
				if player then return end
			end
		end

		local playerName = player and (player.DisplayName or player.Name) or targetModel.Name
		partName = partName or "Body"
		local damageText = damage % 1 == 0 and tostring(damage) or string.format("%.1f", damage)
		local text = hitNotifyBuildMessage(playerName, damageText, partName)
		local key = playerName .. "|" .. partName .. "|" .. tostring(math.floor(damage * 10))
		if HitNotifyState.LastNotifyKey == key and now - (HitNotifyState.LastNotifyTime or 0) < 0.08 then
			return
		end
		HitNotifyState.LastNotifyKey = key
		HitNotifyState.LastNotifyTime = now
		SaveManager:Notify(text, 2)
	end


	local function hitNotifyTryInstallNumberEffect()
		return pcall(function()
			local fighterController = require(lp.PlayerScripts.Controllers.FighterController)
			local fighter = fighterController.LocalFighter or fighterController:GetFighter(lp)
			local fighterClass = fighter and getmetatable(fighter)
			fighterClass = fighterClass and fighterClass.__index
			if type(fighterClass) ~= "table" or type(fighterClass._DamageNumberEffect) ~= "function" then
				error("fighterClass._DamageNumberEffect unavailable")
			end
			if HitNotifyState.WrappedNumberEffect
				and fighterClass._DamageNumberEffect == HitNotifyState.WrappedNumberEffect then
				return
			end
			local original = fighterClass._DamageNumberEffect
			HitNotifyState.OriginalNumberEffect = original
			HitNotifyState.WrappedNumberEffect = function(self, ...)
				local isLocal = false
				pcall(function()
					if type(self) ~= "table" then return end
					if self.Player == lp or self.IsLocalPlayer == true or self.IsLocal == true then
						isLocal = true
					elseif self.ClientFighter and self.ClientFighter.Player == lp then
						isLocal = true
					elseif self.LocalPlayer == true then
						isLocal = true
					end
				end)
				if isLocal and HitNotify.Enabled then
					local args = table.pack(...)
					local damage, part, character
					for i = 2, args.n do
						local v = args[i]
						damage = damage or hitNotifyGetDamageValue(v, 0)
						if not part then
							part, character = hitNotifyFindDamageTarget(v, 0)
						end
					end
					if damage and character then
						local partName = part and hitNotifyGetPartName(part) or "Body"
						hitNotifyMarkAttack(character)
						pcall(hitNotifyEmit, character, damage, partName, true)
					end
				end
				local result = table.pack(original(self, ...))
				return unpack(result, 1, result.n)
			end
			fighterClass._DamageNumberEffect = HitNotifyState.WrappedNumberEffect
		end)
	end

	local function hitNotifyTryInstallDamageEffect()
		return pcall(function()
			local itemInterface = require(lp.PlayerScripts.Modules.ClientReplicatedClasses.ClientFighter.ClientItem.ItemInterface)
			if type(itemInterface) ~= "table" or type(itemInterface.DamageEffect) ~= "function" then
				error("ItemInterface.DamageEffect unavailable")
			end
			if HitNotifyState.WrappedDamageEffect
				and itemInterface.DamageEffect == HitNotifyState.WrappedDamageEffect then
				return
			end
			local original = itemInterface.DamageEffect
			HitNotifyState.OriginalDamageEffect = original
			HitNotifyState.WrappedDamageEffect = function(self, data, ...)
				if HitNotify.Enabled then
					local damage = hitNotifyGetDamageValue(data, 0)
					local part, character = hitNotifyFindDamageTarget(data, 0)
					if damage and character then
						local partName = part and hitNotifyGetPartName(part) or "Body"
						hitNotifyMarkAttack(character)
						pcall(hitNotifyEmit, character, damage, partName, true)
					end
				end
				return original(self, data, ...)
			end
			itemInterface.DamageEffect = HitNotifyState.WrappedDamageEffect
		end)
	end

	local function hitNotifyStartHealthWatch()
		if HitNotifyState.WatchConn then return end
		HitNotifyState.WatchHumanoids = HitNotifyState.WatchHumanoids or setmetatable({}, {__mode = "k"})

		local tracked = HitNotifyState.WatchHumanoids

		local function track(hum)
			if tracked[hum] then return end
			local model = hum.Parent
			if not model or not model:IsA("Model") then return end
			tracked[hum] = { Model = model, LastHealth = hum.Health }
			hum:GetPropertyChangedSignal("Health"):Connect(function()
				if not HitNotify.Enabled then return end
				local state = tracked[hum]
				if not state then return end
				local newH = hum.Health
				local oldH = state.LastHealth
				state.LastHealth = newH
				state.Model = hum.Parent or state.Model
				if newH >= oldH then return end
				local now = tick()
				local recent = now - (HitNotifyState.LastShotAt or 0) <= 1.35
					or now - (HitNotifyState.LastAttackAt or 0) <= 1.35
				if not recent then return end
				local damage = oldH - newH
				if damage <= 0 then return end
				local mdl = state.Model
				if not mdl or mdl == (lp and lp.Character) then return end
				local plr = players:GetPlayerFromCharacter(mdl)
				if plr == lp then return end
				local lastTarget = HitNotifyState.LastTargetCharacter
				if lastTarget and lastTarget ~= mdl and plr then return end
				local head = mdl:FindFirstChild("Head")
					or mdl:FindFirstChild("HitboxHead")
					or mdl:FindFirstChild("HitboxBody")
					or mdl:FindFirstChild("HumanoidRootPart")
				local partName = head and hitNotifyGetPartName(head) or "Body"
				pcall(hitNotifyEmit, mdl, damage, partName, false)
			end)
		end

		for _, obj in ipairs(workspace:GetDescendants()) do
			if obj:IsA("Humanoid") then track(obj) end
		end

		HitNotifyState.WatchConn = workspace.DescendantAdded:Connect(function(obj)
			if obj:IsA("Humanoid") then
				task.defer(track, obj)
			end
		end)
	end

	local function hitNotifyStopHealthWatch()
		if HitNotifyState.WatchConn then
			pcall(function() HitNotifyState.WatchConn:Disconnect() end)
			HitNotifyState.WatchConn = nil
		end
		if HitNotifyState.WatchHumanoids then
			table.clear(HitNotifyState.WatchHumanoids)
		end
	end

	local function hitNotifyStartShotWatch()
		if HitNotifyState.ShotConn then return end
		local lastAmmo
		local function doMeleeProximityTarget()
			local char = lp and lp.Character
			local hrp = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"))
			if not hrp then return nil end
			local overlap = OverlapParams.new()
			overlap.FilterType = Enum.RaycastFilterType.Exclude
			overlap.FilterDescendantsInstances = {char}
			local parts = workspace:GetPartBoundsInRadius(hrp.Position, 16, overlap)
			local best, bestDist
			for _, p in ipairs(parts) do
				local c = hitNotifyGetCharacter(p)
				if c and c ~= char then
					local root = c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso") or c.PrimaryPart or p
					local d = (root.Position - hrp.Position).Magnitude
					if not bestDist or d < bestDist then
						best, bestDist = c, d
					end
				end
			end
			return best
		end
		local function doAimRaycast()
			local cam = workspace.CurrentCamera
			if not cam then return end
			local origin = cam.CFrame.Position
			local direction = cam.CFrame.LookVector * 1000
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			params.FilterDescendantsInstances = {lp.Character, cam}
			params.IgnoreWater = true
			local hit = workspace:Raycast(origin, direction, params)
			local targetChar
			if hit and hit.Instance then
				targetChar = hitNotifyGetCharacter(hit.Instance)
			end
			if not targetChar then
				local probe = origin + cam.CFrame.LookVector * 80
				local parts = workspace:GetPartBoundsInRadius(probe, 14, OverlapParams.new())
				for _, p in ipairs(parts) do
					local c = hitNotifyGetCharacter(p)
					if c and c ~= lp.Character then
						targetChar = c
						break
					end
				end
			end
			if not targetChar then
				targetChar = doMeleeProximityTarget()
			end
			hitNotifyMarkAttack(targetChar)
		end

		local lastMouseClick = 0
		local mouseConn = uis.InputBegan:Connect(function(input, processed)
			if processed then return end
			local uit = input.UserInputType
			if uit == Enum.UserInputType.MouseButton1 or uit == Enum.UserInputType.Touch then
				local now = tick()
				if now - lastMouseClick < 0.04 then return end
				lastMouseClick = now
				doAimRaycast()
			end
		end)
		HitNotifyState.MouseConn = mouseConn

		HitNotifyState.ShotConn = RunService.Heartbeat:Connect(function()
			if not HitNotify.Enabled then return end
			local ok, fighter = pcall(function()
				local fc = require(lp.PlayerScripts.Controllers.FighterController)
				return fc.LocalFighter or fc:GetFighter(lp)
			end)
			if not ok or not fighter then return end
			local item = fighter.EquippedItem
			if not item then return end
			local ok2, ammo = pcall(function() return item:Get("Ammo") end)
			if ok2 and type(ammo) == "number" then
				if lastAmmo and ammo < lastAmmo then
					doAimRaycast()
				end
				lastAmmo = ammo
			end
			pcall(function()
				local attacking = false
				if type(item.Get) == "function" then
					attacking = item:Get("Attacking") or item:Get("IsAttacking") or item:Get("MeleeAttacking")
				end
				if attacking then
					doAimRaycast()
				end
			end)
		end)
	end

	local function hitNotifyStopShotWatch()
		if HitNotifyState.ShotConn then
			pcall(function() HitNotifyState.ShotConn:Disconnect() end)
			HitNotifyState.ShotConn = nil
		end
		if HitNotifyState.MouseConn then
			pcall(function() HitNotifyState.MouseConn:Disconnect() end)
			HitNotifyState.MouseConn = nil
		end
	end

	local function hitNotifyTryInstall()
		local results = {
			hitNotifyTryInstallNumberEffect(),
			hitNotifyTryInstallDamageEffect(),
		}
		local ok = false
		for _, r in ipairs(results) do
			if r then ok = true end
		end
		if ok then HitNotifyState.Hooked = true end
		return ok
	end

	HitNotifyState.InstallGen = (HitNotifyState.InstallGen or 0) + 1
	local startGen = HitNotifyState.InstallGen
	task.spawn(function()
		local waited = 0
		while HitNotifyState.InstallGen == startGen and waited < 300 do
			if hitNotifyTryInstall() then
				while HitNotifyState.InstallGen == startGen do
					task.wait(3)
					hitNotifyTryInstall()
				end
				return
			end
			waited = waited + 0.5
			task.wait(0.5)
		end
	end)

	local function hitNotifyInstallHooks()
		HitNotifyState.InstallGen = (HitNotifyState.InstallGen or 0) + 1
		local gen = HitNotifyState.InstallGen
		if hitNotifyTryInstall() then
			return true
		end
		task.spawn(function()
			for _ = 1, 240 do
				if HitNotifyState.InstallGen ~= gen then return end
				task.wait(0.5)
				if hitNotifyTryInstall() then
					return
				end
			end
		end)
		return false
	end

	local function hitNotifyRemoveHooks()
		HitNotifyState.InstallGen = (HitNotifyState.InstallGen or 0) + 1
		pcall(function()
			local fighterController = require(lp.PlayerScripts.Controllers.FighterController)
			local fighter = fighterController.LocalFighter or fighterController:GetFighter(lp)
			local fighterClass = fighter and getmetatable(fighter)
			fighterClass = fighterClass and fighterClass.__index
			if fighterClass
				and fighterClass._DamageNumberEffect == HitNotifyState.WrappedNumberEffect
				and HitNotifyState.OriginalNumberEffect then
				fighterClass._DamageNumberEffect = HitNotifyState.OriginalNumberEffect
			end
		end)
		pcall(function()
			local itemInterface = require(lp.PlayerScripts.Modules.ClientReplicatedClasses.ClientFighter.ClientItem.ItemInterface)
			if itemInterface
				and itemInterface.DamageEffect == HitNotifyState.WrappedDamageEffect
				and HitNotifyState.OriginalDamageEffect then
				itemInterface.DamageEffect = HitNotifyState.OriginalDamageEffect
			end
		end)

		HitNotifyState.Hooked = false
	end

