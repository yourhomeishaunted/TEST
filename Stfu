if slotName == "Melee" then
						-- NATURAL BACKSTAB (Work with the server, not against it)
						local targetChar = targetPlayer and targetPlayer.Character
						if targetChar and targetHead then
							
							-- 1. Find the absolute center of the target's head
							local headCenter = targetHead.Position
							
							-- 2. Look exactly at their HumanoidRootPart (their torso)
							-- This forces the camera/character to face their back.
							local lookAtTorso = targetRoot.Position
							
							-- 3. Create the perfect backstab CFrame
							local backstabCF = CFrame.lookAt(headCenter, lookAtTorso)
							
							-- 4. Apply the position instantly
							lplr.Character.HumanoidRootPart.CFrame = backstabCF
							
							-- 5. Build the packet so the server knows you are inside the head
							local naturalCamData = {
								[utf8.char(1)] = {
									[utf8.char(0)] = util:EncodeCFrame(backstabCF),
									[utf8.char(1)] = util:EncodeCFrame(targetHead.CFrame),
									[utf8.char(2)] = targetHead,
									[utf8.char(3)] = util:EncodeCFrame(CFrame.new(0,0,0)),
								}
							}
							
							-- 6. Scope in so the knife actually swings
							pcall(function()
								local lf = FighterController.LocalFighter
								if lf and type(lf.Input) == "function" then
									lf:Input("StartAiming")
								end
							end)

							-- 7. Fire the attack
							local heavy = enum:ToEnum("HeavyAttackAnimation1") or enum:ToEnum("HeavyAttack1")
							local atk = enum:ToEnum("AttackAnimation1") or enum:ToEnum("Attack1")
							local z1 = utf8.char(1)
							local z2 = utf8.char(2)
							
							for _ = 1, 15 do
								pcall(function() remote:FireServer(objectId, enum:ToEnum("StartAiming"), {[z1] = naturalCamData[z1], [z2] = heavy}, nil) end)
								pcall(function() remote:FireServer(objectId, shot, {[z1] = naturalCamData[z1], [z2] = atk}, nil) end)
								pcall(function() remote:FireServer(objectId, shot, naturalCamData, nil) end)
							end
							
							setRageHud("ragebot: backstab @" .. targetPlayer.Name)
						end
					end
